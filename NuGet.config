<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      Per-checkout package cache instead of the machine-wide ~/.nuget/packages. The design system
      is always packed as version 0.1.0 during local dev, and NuGet treats a cached version as
      immutable, so pack.mts evicts it before every repack. With a shared cache, every git
      worktree on this machine would evict and overwrite the others' copy, breaking their running
      demo servers and serving them another checkout's half-finished CSS. Relative to this file.
    -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local, gitignored folder that `nx run design-system-blazor:pack` (dotnet pack) writes
      into. Lets apps in this workspace (e.g. apps/blazor-design-system-docs) restore
      PartoBita.DesignSystem.Blazor via a normal PackageReference during local development,
      without publishing to a real NuGet feed.
    -->
    <add key="design-system-local" value="local-nuget-feed" />
  </packageSources>
</configuration>
