<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local, gitignored folder that `nx run design-system-blazor:pack` (dotnet pack) writes
      into. Lets apps in this workspace (e.g. apps/samamat) restore
      PartoBita.DesignSystem.Blazor via a normal PackageReference during local development,
      without publishing to a real NuGet feed.
    -->
    <add key="design-system-local" value="local-nuget-feed" />
  </packageSources>
</configuration>
