@inherits WorkspaceComponentBase
<div
    class="workspace-progress workspace-progress--@(Indeterminate ? "indeterminate" : "determinate")"
    role="progressbar"
    aria-label="@Label"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="@(Indeterminate ? null : Value)"
    @attributes="AdditionalAttributes">
    @if (BufferValue.HasValue)
    {
        <div class="workspace-progress__buffer" style="width:@(BufferValue.Value)%"></div>
    }
    <div class="workspace-progress__track" style="@(Indeterminate ? "" : $"width:{Value}%")"></div>
</div>
