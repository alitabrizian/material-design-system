@inherits WorkspaceComponentBase
@if (Mode == PBSidenavMode.Over)
{
    <div class="pb-sidenav-backdrop @(Opened ? "pb-sidenav-backdrop--shown" : null)" @onclick="CloseAsync" aria-hidden="true"></div>
}
<aside class="@CssClass @UserClass" aria-label="@Label" inert="@(Mode == PBSidenavMode.Over && !Opened)"
       role="@(Mode == PBSidenavMode.Over && Opened ? "dialog" : null)" aria-modal="@(Mode == PBSidenavMode.Over && Opened ? "true" : null)"
       tabindex="-1" @onkeydown="OnKeyDownAsync" @attributes="Attrs">
    <div class="pb-sidenav__inner">@ChildContent</div>
</aside>
