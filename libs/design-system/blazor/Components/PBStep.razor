@inherits WorkspaceComponentBase
@implements IDisposable

@code {
    [CascadingParameter] private PBStepper? Stepper { get; set; }

    /// <summary>Rich label content (matStepLabel), used instead of <c>Label</c>.</summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }

    /// <summary>Overrides the automatic completed state (steps left behind count as completed).</summary>
    [Parameter] public bool? Completed { get; set; }

    [Parameter] public bool Optional { get; set; }

    /// <summary>Completed steps show a pencil and can be revisited (default), or a check and stay locked.</summary>
    [Parameter] public bool Editable { get; set; } = true;

    [Parameter] public bool HasError { get; set; }

    [Parameter] public string? ErrorMessage { get; set; }

    internal bool Interacted { get; set; }

    private (string?, bool?, bool, bool)? rendered;

    protected override void OnInitialized() => Stepper?.Register(this);

    protected override void OnParametersSet()
    {
        var current = (Label, Completed, HasError, Optional);
        if (rendered is not null && rendered != current) Stepper?.Refresh();
        rendered = current;
    }

    public void Dispose() => Stepper?.Unregister(this);
}
