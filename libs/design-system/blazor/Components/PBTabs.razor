@inherits WorkspaceComponentBase
@inject Microsoft.JSInterop.IJSRuntime JS
<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
<div class="@CssClass @UserClass" @attributes="Attrs">
    <div class="pb-tabs__header">
        <div @ref="tablist" class="pb-tabs__labels" role="tablist" aria-label="@Label" @onkeydown="OnKeyDownAsync">
            @for (var i = 0; i < tabs.Count; i++)
            {
                var index = i;
                var tab = tabs[i];
                var active = index == SelectedIndex;
                <button type="button" role="tab" id="@TabId(index)"
                        class="pb-tab pb-interactive pb-ripple-host @(active ? "pb-tab--active" : null)"
                        aria-selected="@(active ? "true" : "false")" aria-controls="@PanelId(index)"
                        tabindex="@(active ? 0 : -1)" disabled="@tab.Disabled"
                        @onclick="() => SelectAsync(index)">
                    <span class="pb-state-layer"></span>
                    <span class="pb-tab__content">
                        @if (tab.Icon is not null)
                        {
                            <span class="pb-tab__icon pb-icon-slot" aria-hidden="true">@tab.Icon</span>
                        }
                        <span class="pb-tab__label">@(tab.LabelContent ?? (RenderFragment)(b => b.AddContent(0, tab.Label)))</span>
                    </span>
                    <span class="pb-tab__indicator" aria-hidden="true"><span class="pb-tab__indicator-content"></span></span>
                </button>
            }
        </div>
    </div>
    <div class="pb-tabs__body">
        @if (SelectedIndex >= 0 && SelectedIndex < tabs.Count)
        {
            <div @key="SelectedIndex" class="pb-tabs__panel" role="tabpanel" id="@PanelId(SelectedIndex)" aria-labelledby="@TabId(SelectedIndex)" tabindex="0">
                @tabs[SelectedIndex].ChildContent
            </div>
        }
    </div>
</div>
