@* The mat-form-field DOM shared by every PB field component. Not meant to be used directly;
   use PBFormField to wrap your own control. *@
<div class="@CssClass" @attributes="Attributes">
    <div class="pb-form-field__wrapper">
        @if (Appearance == PBFormFieldAppearance.Fill)
        {
            <div class="pb-form-field__focus-overlay"></div>
        }
        @if (Prefix is not null)
        {
            <span class="pb-form-field__prefix"><span class="pb-icon-slot">@Prefix</span></span>
        }
        <div class="pb-form-field__infix">
            @Control
            @if (!string.IsNullOrEmpty(Label))
            {
                <label class="pb-form-field__label @(Required ? "pb-form-field__label--required" : null)" for="@LabelFor" id="@(LabelFor + "-label")">@Label</label>
            }
        </div>
        @if (Suffix is not null)
        {
            <span class="pb-form-field__suffix">@Suffix</span>
        }
        @if (Appearance == PBFormFieldAppearance.Fill)
        {
            <div class="pb-form-field__line"></div>
        }
        else
        {
            <fieldset class="pb-form-field__outline" aria-hidden="true">
                @if (!string.IsNullOrEmpty(Label))
                {
                    <legend><span>@Label@(Required ? "*" : null)</span></legend>
                }
            </fieldset>
        }
    </div>
    <div class="pb-form-field__subscript">
        @if (!string.IsNullOrEmpty(HintText))
        {
            <span id="@(LabelFor + "-hint")" role="@(HasError ? "alert" : null)">@HintText</span>
        }
    </div>
</div>

@code {
    [Parameter] public PBFormFieldAppearance Appearance { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? LabelFor { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string? HintText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Floating { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public RenderFragment? Prefix { get; set; }
    [Parameter] public RenderFragment? Suffix { get; set; }
    [Parameter] public RenderFragment? Control { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string CssClass =>
        "pb-form-field"
        + (Appearance == PBFormFieldAppearance.Outline ? " pb-form-field--outline" : " pb-form-field--fill")
        + (string.IsNullOrEmpty(Label) ? "" : " pb-form-field--has-label")
        + (HasError ? " pb-form-field--error" : "")
        + (Disabled ? " pb-form-field--disabled" : "")
        + (Floating ? " pb-form-field--floating" : "")
        + (Block ? " pb-form-field--block" : "")
        + (Prefix is not null ? " pb-form-field--has-prefix" : "")
        + (Suffix is not null ? " pb-form-field--has-suffix" : "")
        + (ExtraClass is null ? "" : " " + ExtraClass);
}
