@inherits WorkspaceComponentBase
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<dialog @ref="dialog" class="pb-dialog @UserClass" aria-labelledby="@(Label is null && Title is null ? null : TitleId)"
        aria-modal="true" @attributes="Attrs">
    @if (Open || Inline)
    {
        @if (Label is not null || Title is not null)
        {
            <h2 class="pb-dialog__title" id="@TitleId">@Label@Title</h2>
        }
        <div class="pb-dialog__content">@ChildContent</div>
        @if (Actions is not null)
        {
            <div class="pb-dialog__actions">@Actions</div>
        }
    }
</dialog>
