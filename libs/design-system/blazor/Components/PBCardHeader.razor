@inherits WorkspaceComponentBase
<div class="pb-card__header @UserClass" @attributes="Attrs">
    @if (Avatar is not null)
    {
        <div class="pb-card__avatar">@Avatar</div>
    }
    <div class="pb-card__header-text">
        @if (Title is not null)
        {
            <div class="pb-card__title">@Title</div>
        }
        @if (Subtitle is not null)
        {
            <div class="pb-card__subtitle">@Subtitle</div>
        }
        @ChildContent
    </div>
</div>

@code {
    /// <summary>mat-card-title (title-large).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>mat-card-subtitle (title-medium).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>mat-card-avatar: a 40px circle, e.g. an &lt;img&gt;.</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }
}
