@inherits WorkspaceComponentBase
<div class="pb-grid-tile @UserClass" role="listitem" style="@Style" @attributes="Attrs">
    <div class="pb-grid-tile__content">@ChildContent</div>
    @if (Header is not null)
    {
        <div class="pb-grid-tile__header">@Header</div>
    }
    @if (Footer is not null)
    {
        <div class="pb-grid-tile__footer">@Footer</div>
    }
</div>

@code {
    [Parameter] public int Colspan { get; set; } = 1;
    [Parameter] public int Rowspan { get; set; } = 1;

    /// <summary>mat-grid-tile-header: a 48px bar over the top of the tile.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>mat-grid-tile-footer: a 48px bar over the bottom of the tile.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    private string Style => $"grid-column:span {Math.Max(1, Colspan)};grid-row:span {Math.Max(1, Rowspan)};";
}
