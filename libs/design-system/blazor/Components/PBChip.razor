@inherits WorkspaceComponentBase
<span class="@CssClass @UserClass" role="@HostRole" aria-selected="@(Variant == PBChipVariant.Filter ? (Selected ? "true" : "false") : null)"
      @attributes="Attrs">
    <span class="pb-chip__focus-overlay" aria-hidden="true"></span>
    @if (IsInteractive)
    {
        <button type="button" class="pb-chip__action pb-ripple-host" disabled="@Disabled"
                @onclick="OnPrimaryClickAsync">
            @Graphic
            <span class="pb-chip__label">@Label@ChildContent</span>
        </button>
    }
    else
    {
        <span class="pb-chip__action">
            @Graphic
            <span class="pb-chip__label">@Label@ChildContent</span>
        </span>
    }
    @if (Removable)
    {
        <button type="button" class="pb-chip__remove" disabled="@Disabled" aria-label="@($"Remove {Label}")" @onclick="OnRemove">
            <span class="material-icons" aria-hidden="true">cancel</span>
        </button>
    }
</span>

@code {
    private RenderFragment? Graphic => HasGraphic ? @<span class="pb-chip__graphic" aria-hidden="true">
            @if (Icon is not null)
            {
                <span class="pb-chip__icon pb-icon-slot">@Icon</span>
            }
            @if (Variant == PBChipVariant.Filter)
            {
                <svg class="pb-chip__checkmark" viewBox="-2 -3 30 30" focusable="false"><path d="M1.73,12.91 8.1,19.28 22.79,4.59" /></svg>
            }
        </span> : null;
}
