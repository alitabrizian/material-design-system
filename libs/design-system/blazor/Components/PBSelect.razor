@inherits WorkspaceFieldComponentBase
<div class="workspace-field">
    <label class="workspace-field-control @(ErrorText is not null ? "workspace-field-control--error" : "")">
        <select @attributes="AdditionalAttributes">@ChildContent</select>
        <span class="workspace-field-label">@Label</span>
    </label>
    @if (FieldHintText is not null)
    {
        <span class="@FieldHintClass">@FieldHintText</span>
    }
</div>
