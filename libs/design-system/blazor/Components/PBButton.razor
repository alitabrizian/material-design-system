@inherits WorkspaceComponentBase
@if (Href is not null)
{
    <a class="@CssClass"
       href="@(Disabled ? null : Href)"
       aria-disabled="@(Disabled ? "true" : null)"
       tabindex="@(Disabled && !DisabledInteractive ? -1 : (int?)null)"
       @attributes="ForwardedAttributes">@Content</a>
}
else
{
    <button class="@CssClass"
            type="@Type"
            disabled="@(Disabled && !DisabledInteractive)"
            aria-disabled="@(Disabled && DisabledInteractive ? "true" : null)"
            @attributes="ForwardedAttributes">@Content</button>
}

@code {
    private RenderFragment Content => @<text>
        <span class="pb-state-layer"></span>
        @if (IconStart is not null)
        {
            <span class="pb-button__icon pb-button__icon--start pb-icon-slot" aria-hidden="true">@IconStart</span>
        }
        <span class="pb-button__label">@ChildContent</span>
        @if (IconEnd is not null)
        {
            <span class="pb-button__icon pb-button__icon--end pb-icon-slot" aria-hidden="true">@IconEnd</span>
        }
        @if (ShowProgress)
        {
            <span class="pb-button__progress">@ProgressIndicator</span>
        }
        <span class="pb-touch-target" aria-hidden="true"></span>
    </text>;
}
