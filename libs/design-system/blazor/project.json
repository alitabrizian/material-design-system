{
  "name": "design-system-blazor",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": ["tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "dotnet build Design.csproj",
        "cwd": "libs/design-system/blazor"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "node libs/design-system/blazor/scripts/pack.mts",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/local-nuget-feed"]
    }
  },
  "tags": ["type:lib", "scope:design-system"]
}
