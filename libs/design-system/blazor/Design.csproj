<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PartoBita.DesignSystem.Blazor</PackageId>
    <Version>0.1.0</Version>
    <Authors>Parto Bita</Authors>
    <Description>Material 3 (PB-prefixed) Blazor component library and design tokens.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Without this, the _content/{X}/... static web asset path segment defaults to the assembly
      name ("Design") when consumed via ProjectReference, but to the NuGet PackageId
      ("PartoBita.DesignSystem.Blazor") when consumed via PackageReference to the packed nupkg,
      silently breaking every _content/Design/... link the moment a consumer switches from a
      source reference to the real package. Pinning it keeps the asset path stable either way.
    -->
    <StaticWebAssetBasePath>_content/Design</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- Nx project config, not library content: the default RCL content glob would otherwise pack it. -->
    <Content Remove="project.json" />
    <None Remove="project.json" />
  </ItemGroup>

  <!--
    Explicit component-model packages instead of <FrameworkReference Include="Microsoft.AspNetCore.App" />:
    this library only touches Microsoft.AspNetCore.Components(.Web) APIs, and FrameworkReference to the full
    ASP.NET Core shared framework is not supported by Blazor WebAssembly consumers. Package references keep
    the library consumable from both Blazor Server and Blazor WebAssembly apps.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

  <!--
    Design tokens are owned by the framework-neutral libs/design-system/tokens package, not by
    this library. Its build output (dist/css/*.css, dist/data/palettes.json) is copied into
    wwwroot here on every build, so it ships as ordinary static web assets under
    _content/Design/..., so consumers see no difference. The copies are gitignored.

    The copied files are also (re)declared as Content items: wwwroot's default glob is evaluated
    before any target runs, so on a first build the freshly copied files would otherwise be
    missing from the static web assets manifest.
  -->
  <PropertyGroup>
    <DesignTokensDist>$(MSBuildThisFileDirectory)..\tokens\dist\</DesignTokensDist>
  </PropertyGroup>

  <Target Name="SyncDesignTokens" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(DesignTokensDist)css\tokens.css')"
      Text="Design tokens not built ($(DesignTokensDist) is missing). Run 'npx nx run tokens:build' first." />
    <ItemGroup>
      <_DesignTokenFile Include="$(DesignTokensDist)**\*" />
      <_DesignTokenCopy Include="@(_DesignTokenFile->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_DesignTokenFile)" DestinationFiles="@(_DesignTokenCopy)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Remove="@(_DesignTokenCopy)" />
      <Content Include="@(_DesignTokenCopy)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Constitution principle II: no literal colors outside the generated tokens. The audit runs on
    every library build (Node is already required here: the tokens are built with it) and fails
    the build with file:line for any hex/rgb()/named color in components, styles or the demo.
  -->
  <Target Name="AuditColors" BeforeTargets="BeforeBuild" Condition="'$(SkipColorAudit)' != 'true'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)../../../tools/scripts/audit-colors.mts&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)../../.."
          CustomErrorRegularExpression="violation\(s\) --"
          ConsoleToMSBuild="true" />
  </Target>
</Project>
