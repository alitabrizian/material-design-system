{
  "name": "tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "generate-palettes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/generate-palettes.mts",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/libs/design-system/blazor/wwwroot/css/tokens.css",
        "{workspaceRoot}/libs/design-system/blazor/wwwroot/data/palettes.json"
      ]
    }
  },
  "tags": ["type:tooling", "scope:design-system"]
}
