{
  "name": "design-system-angular",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/material-design-system/angular/src",
  "implicitDependencies": ["design-tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["design-tokens:build"],
      "options": {
        "command": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
        "cwd": "libs/material-design-system/angular"
      },
      "outputs": ["{workspaceRoot}/dist/libs/material-design-system/angular"]
    }
  },
  "tags": ["type:lib", "scope:design-system"]
}
