@inherits WorkspaceFieldComponentBase
@typeparam TItem
@inject Microsoft.JSInterop.IJSRuntime JS

<FormFieldFrame Appearance="Appearance" Label="@Label" LabelFor="@ControlId" HasError="HasError" HintText="@FieldHintText"
                Disabled="!Enabled" Block="Block" Prefix="Prefix" Suffix="Suffix" ExtraClass="@("pb-autocomplete " + UserClass)">
    <Control>
        <input
            @ref="input"
            id="@ControlId"
            type="text"
            class="pb-form-field__control"
            placeholder="@(Placeholder ?? " ")"
            value="@InputValue"
            disabled="@(!Enabled)"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="@(PanelOpen && FilteredOptions.Any() ? "true" : "false")"
            aria-haspopup="listbox"
            aria-controls="autocomplete-panel-@ComponentId"
            aria-activedescendant="@ActiveOptionId"
            aria-invalid="@(HasError ? "true" : null)"
            aria-describedby="@(FieldHintText is null ? null : ControlId + "-hint")"
            @oninput="OnInputChanged"
            @onkeydown="OnKeyPressed"
            @onfocus="OpenPanel"
            @onblur="ClosePanel"
            @attributes="Attrs" />

        @if (PanelOpen && FilteredOptions.Any())
        {
            <div
                @ref="panel"
                id="autocomplete-panel-@ComponentId"
                class="pb-option-panel pb-autocomplete__panel pb-overlay pb-overlay--pending"
                popover="manual"
                role="listbox"
                aria-label="@(Label ?? "Options")">
                @foreach (var (option, optionIdx) in FilteredOptions.Select((o, i) => (o, i)))
                {
                    var optionId = $"option-{ComponentId}-{optionIdx}";
                    var isHighlighted = optionIdx == HighlightedIndex;
                    var isSelected = SelectedOption is not null &&
                        EqualityComparer<TItem>.Default.Equals(SelectedOption, option);

                    <div
                        id="@optionId"
                        class="pb-option @(isHighlighted ? "pb-option--active" : null) @(isSelected ? "pb-option--selected" : null)"
                        role="option"
                        aria-selected="@(isSelected ? "true" : "false")"
                        @onmouseenter="() => { HighlightedIndex = optionIdx; UpdateActiveOptionId(); }"
                        @onmousedown="() => SelectOption(option)"
                        @onmousedown:preventDefault="true">
                        <span class="pb-option__text">@GetDisplayText(option)</span>
                    </div>
                }
            </div>
        }
    </Control>
</FormFieldFrame>

@code {
    [Parameter] public IEnumerable<TItem>? Options { get; set; }
    [Parameter] public TItem? SelectedOption { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedOptionChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string? DisplayProperty { get; set; }
    [Parameter] public string? ValueProperty { get; set; }
    [Parameter] public Func<string, IEnumerable<TItem>, IEnumerable<TItem>>? Filter { get; set; }
    [Parameter] public string? FilterHint { get; set; }

    // --- state ---
    private bool PanelOpen { get; set; }
    private int HighlightedIndex { get; set; }
    private string InputValue { get; set; } = string.Empty;
    private IEnumerable<TItem> FilteredOptions { get; set; } = Enumerable.Empty<TItem>();
    private string? ActiveOptionId { get; set; }
    private string ComponentId { get; } = Guid.NewGuid().ToString("N")[..8];
    private ElementReference input;
    private ElementReference panel;
    private bool panelWasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isOpen = PanelOpen && FilteredOptions.Any();
        if (isOpen && !panelWasOpen)
        {
            await DesignSystemJs.InvokeVoidAsync(JS, "position", panel, input, new
            {
                x = "start",
                matchWidth = true,
                anchorClosest = ".pb-form-field",
                anchorSelector = ".pb-form-field__wrapper",
            });
        }
        else if (isOpen)
        {
            await DesignSystemJs.InvokeVoidAsync(JS, "scrollIntoView", panel, ".pb-option--active");
        }
        panelWasOpen = isOpen;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        PerformFilter();
    }

    private void PerformFilter()
    {
        if (Options is null)
        {
            FilteredOptions = Enumerable.Empty<TItem>();
            return;
        }

        var optionsList = Options.ToList();

        if (Filter is not null)
        {
            FilteredOptions = Filter(InputValue, optionsList);
        }
        else
        {
            if (string.IsNullOrWhiteSpace(InputValue))
            {
                FilteredOptions = optionsList;
            }
            else
            {
                var lower = InputValue.ToLowerInvariant();
                FilteredOptions = optionsList.Where(o =>
                {
                    var text = GetDisplayText(o);
                    return text.ToLowerInvariant().StartsWith(lower, StringComparison.Ordinal);
                });
            }
        }

        var count = FilteredOptions.Count();
        if (HighlightedIndex < 0 || HighlightedIndex >= count)
            HighlightedIndex = 0;
    }

    private void UpdateActiveOptionId()
    {
        var list = FilteredOptions.ToList();
        if (list.Count > 0 && HighlightedIndex >= 0 && HighlightedIndex < list.Count)
            ActiveOptionId = $"option-{ComponentId}-{HighlightedIndex}";
        else
            ActiveOptionId = null;
    }

    private void OpenPanel()
    {
        if (!Enabled) return;
        PanelOpen = true;
        HighlightedIndex = 0;
        UpdateActiveOptionId();
        StateHasChanged();
    }

    private void ClosePanel()
    {
        PanelOpen = false;
        HighlightedIndex = 0;
        ActiveOptionId = null;
        StateHasChanged();
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (!Enabled) return;

        InputValue = e.Value?.ToString() ?? string.Empty;
        PerformFilter();
        HighlightedIndex = 0;
        UpdateActiveOptionId();

        if (!PanelOpen && FilteredOptions.Any())
            OpenPanel();

        await Task.Yield();
    }

    private async Task OnKeyPressed(KeyboardEventArgs e)
    {
        if (!Enabled) return;

        var count = FilteredOptions.Count();

        switch (e.Key)
        {
            case "ArrowDown":
                if (count > 0)
                {
                    HighlightedIndex = (HighlightedIndex + 1) % count;
                    EnsurePanelOpen();
                    UpdateActiveOptionId();
                }
                break;

            case "ArrowUp":
                if (count > 0)
                {
                    HighlightedIndex = (HighlightedIndex - 1 + count) % count;
                    EnsurePanelOpen();
                    UpdateActiveOptionId();
                }
                break;

            case "Enter":
                if (count > 0 && PanelOpen)
                    await SelectOption(FilteredOptions.ElementAt(HighlightedIndex));
                break;

            case "Escape":
                ClosePanel();
                break;
        }

        await Task.Yield();
    }

    private void EnsurePanelOpen()
    {
        if (!PanelOpen && FilteredOptions.Any())
            OpenPanel();
    }

    private async Task SelectOption(TItem option)
    {
        await SelectedOptionChanged.InvokeAsync(option);
        InputValue = GetDisplayText(option);
        HighlightedIndex = 0;
        UpdateActiveOptionId();
        ClosePanel();
    }

    private string GetDisplayText(TItem item)
    {
        if (DisplayProperty is not null)
        {
            var prop = typeof(TItem).GetProperty(DisplayProperty);
            if (prop is not null)
                return prop.GetValue(item)?.ToString() ?? string.Empty;
        }

        return item is not null ? item.ToString() ?? string.Empty : string.Empty;
    }

    // public so the demo page can call it for display
    public string? GetValue(TItem item)
    {
        if (ValueProperty is not null)
        {
            var prop = typeof(TItem).GetProperty(ValueProperty);
            if (prop is not null)
                return prop.GetValue(item)?.ToString();
        }

        return item is not null ? item.ToString() : null;
    }
}
