@typeparam TValue
@inherits WorkspaceFieldComponentBase
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<CascadingValue Value="this" IsFixed="true">
    <FormFieldFrame Appearance="Appearance" Label="@Label" LabelFor="@ControlId" HasError="HasError" HintText="@FieldHintText"
                    Disabled="Disabled" Required="Required" Floating="IsFloating" Block="Block" Prefix="Prefix" Suffix="Suffix"
                    ExtraClass="@("pb-select-field " + UserClass)">
        <Control>
            <div @ref="trigger"
                 id="@ControlId"
                 class="pb-select @(open ? "pb-select--open" : null) @(Disabled ? "pb-select--disabled" : null)"
                 role="combobox"
                 tabindex="@(Disabled ? -1 : 0)"
                 aria-haspopup="listbox"
                 aria-expanded="@(open ? "true" : "false")"
                 aria-controls="@PanelId"
                 aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : ControlId + "-label")"
                 aria-activedescendant="@(open && ActiveOption is not null ? ActiveOption.Id : null)"
                 aria-disabled="@(Disabled ? "true" : "false")"
                 aria-required="@(Required ? "true" : null)"
                 aria-invalid="@(HasError ? "true" : null)"
                 aria-describedby="@(FieldHintText is null ? null : ControlId + "-hint")"
                 @onclick="ToggleAsync"
                 @onkeydown="OnKeyDownAsync"
                 @attributes="Attrs">
                <div class="pb-select__trigger">
                    <span class="pb-select__value">
                        @if (SelectedOption is not null)
                        {
                            <span class="pb-select__value-text">@SelectedOption.Display</span>
                        }
                        else if (Placeholder is not null)
                        {
                            <span class="pb-select__placeholder">@Placeholder</span>
                        }
                    </span>
                    <span class="pb-select__arrow-wrapper">
                        <span class="pb-select__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="24px" height="24px" focusable="false"><path d="M7 10l5 5 5-5z" /></svg>
                        </span>
                    </span>
                </div>
            </div>
            <div @ref="panel" id="@PanelId" class="pb-option-panel pb-overlay pb-overlay--pending" popover="manual"
                 role="listbox" aria-labelledby="@(string.IsNullOrEmpty(Label) ? null : ControlId + "-label")">
                @ChildContent
            </div>
        </Control>
    </FormFieldFrame>
</CascadingValue>
