@inherits WorkspaceComponentBase
<section class="pb-expansion-panel @(IsExpanded ? "pb-expansion-panel--expanded" : null) @UserClass" @attributes="Attrs">
    <button type="button" id="@HeaderId" class="pb-expansion-panel__header"
            aria-expanded="@(IsExpanded ? "true" : "false")" aria-controls="@BodyId"
            disabled="@Disabled" @onclick="ToggleAsync">
        <span class="pb-expansion-panel__content-row">
            <span class="pb-expansion-panel__title">@Label@Title</span>
            @if (Description is not null)
            {
                <span class="pb-expansion-panel__description">@Description</span>
            }
        </span>
        @if (!HideToggle)
        {
            <span class="pb-expansion-panel__indicator" aria-hidden="true"></span>
        }
    </button>
    <div class="pb-expansion-panel__content-wrapper">
        <div class="pb-expansion-panel__content" id="@BodyId" role="region" aria-labelledby="@HeaderId" inert="@(!IsExpanded)">
            <div class="pb-expansion-panel__body">@ChildContent</div>
            @if (Actions is not null)
            {
                <div class="pb-expansion-panel__actions">@Actions</div>
            }
        </div>
    </div>
</section>
