@inherits WorkspaceComponentBase
@implements IDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<li @ref="item" class="pb-tree-node @UserClass" role="treeitem" style="--pb-tree-level:@Level"
    aria-level="@(Level + 1)" aria-expanded="@(HasChildren ? (Expanded ? "true" : "false") : null)"
    tabindex="@(Tree?.IsTabStop(this) == true ? 0 : -1)"
    @onkeydown="OnKeyDownAsync" @onkeydown:stopPropagation="true" @attributes="Attrs">
    <div class="pb-tree-node__row">
        @if (HasChildren)
        {
            <PBButton Variant="PBButtonVariant.Icon" class="pb-tree-node__toggle" tabindex="-1" aria-label="@($"Toggle {Label}")" @onclick="ToggleAsync">
                <span class="material-icons" aria-hidden="true">@(Expanded ? "expand_more" : "chevron_right")</span>
            </PBButton>
        }
        else
        {
            <span class="pb-tree-node__spacer" aria-hidden="true"></span>
        }
        @if (Icon is not null)
        {
            <span class="pb-tree-node__icon pb-icon-slot" aria-hidden="true">@Icon</span>
        }
        <span class="pb-tree-node__label">@Label@LabelContent</span>
    </div>
    @if (HasChildren && Expanded)
    {
        <ul role="group">
            <CascadingValue Value="this" Name="PBTreeParent">@ChildContent</CascadingValue>
        </ul>
    }
</li>
