@inherits WorkspaceComponentBase
@implements IDisposable

@code {
    [CascadingParameter] private PBTabs? Tabs { get; set; }

    /// <summary>Rich tab label (mat-tab-label template), used instead of <c>Label</c>.</summary>
    [Parameter] public RenderFragment? LabelContent { get; set; }

    /// <summary>Icon shown before the label.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    [Parameter] public bool Disabled { get; set; }

    protected override void OnInitialized() => Tabs?.Register(this);

    private (string? Label, bool Disabled)? rendered;

    // The group renders the header from these values before children receive new parameters, so
    // ask it to re-render when a header-visible value changed. Comparing avoids a render loop
    // (re-rendering the group re-renders this component's ChildContent parameter).
    protected override void OnParametersSet()
    {
        var current = (Label, Disabled);
        if (rendered is not null && rendered != current) Tabs?.Refresh();
        rendered = current;
    }

    public void Dispose() => Tabs?.Unregister(this);
}
