@inherits WorkspaceComponentBase
@implements IDisposable
@if (Inline)
{
    <div class="pb-snackbar pb-snackbar--inline @UserClass" role="status" @attributes="Attrs">@Surface</div>
}
else
{
    <div class="pb-snackbar-container" aria-live="polite">
        @if (Open)
        {
            <div class="pb-snackbar @UserClass" role="status" @attributes="Attrs">@Surface</div>
        }
    </div>
}

@code {
    private RenderFragment Surface => @<text>
        <div class="pb-snackbar__label">@Label@ChildContent</div>
        @if (ActionLabel is not null)
        {
            <div class="pb-snackbar__actions">
                <PBButton @onclick="OnActionAsync">@ActionLabel</PBButton>
            </div>
        }
    </text>;
}
