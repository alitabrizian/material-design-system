@inherits WorkspaceComponentBase
<div class="pb-paginator @UserClass" role="group" aria-label="@(Label ?? "Paginator")" @attributes="Attrs">
    <div class="pb-paginator__container">
        @if (!HidePageSize && PageSizeOptions.Count > 0)
        {
            <div class="pb-paginator__page-size">
                <div class="pb-paginator__page-size-label" id="@LabelId">@ItemsPerPageLabel</div>
                @if (PageSizeOptions.Count > 1)
                {
                    <PBSelect TValue="int" Appearance="PBFormFieldAppearance.Outline" Value="PageSize" ValueChanged="ChangePageSizeAsync"
                              Disabled="Disabled" HideSingleSelectionIndicator="false" aria-labelledby="@LabelId">
                        @foreach (var size in PageSizeOptions)
                        {
                            <PBOption TValue="int" Value="size">@size</PBOption>
                        }
                    </PBSelect>
                }
                else
                {
                    <div class="pb-paginator__page-size-value">@PageSize</div>
                }
            </div>
        }
        <div class="pb-paginator__range-actions">
            <div class="pb-paginator__range-label" aria-live="polite">@RangeLabel</div>
            @if (ShowFirstLastButtons)
            {
                @NavButton(FirstPageLabel, IsFirst, () => GoToAsync(0), "M18.41 16.59L13.82 12l4.59-4.59L17 6l-6 6 6 6zM6 6h2v12H6z")
            }
            @NavButton(PreviousPageLabel, IsFirst, () => GoToAsync(PageIndex - 1), "M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z")
            @NavButton(NextPageLabel, IsLast, () => GoToAsync(PageIndex + 1), "M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z")
            @if (ShowFirstLastButtons)
            {
                @NavButton(LastPageLabel, IsLast, () => GoToAsync(PageCount - 1), "M5.59 7.41L10.18 12l-4.59 4.59L7 18l6-6-6-6zM16 6h2v12h-2z")
            }
        </div>
    </div>
</div>

@code {
    private RenderFragment NavButton(string label, bool disabled, Func<Task> onClick, string path) =>
        @<PBButton Variant="PBButtonVariant.Icon" Disabled="Disabled || disabled" aria-label="@label" title="@label" @onclick="onClick">
            <svg class="pb-paginator__icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="@path" /></svg>
        </PBButton>;
}
