@inherits WorkspaceComponentBase
<div class="pb-spinner pb-spinner--@(IsIndeterminate ? "indeterminate" : "determinate") @UserClass" role="progressbar"
     aria-label="@Label" aria-valuemin="0" aria-valuemax="100"
     aria-valuenow="@(IsIndeterminate ? null : F(Math.Clamp(Value!.Value, 0, 100)))"
     style="width:@(Diameter)px;height:@(Diameter)px;" @attributes="Attrs">
    <div class="pb-spinner__determinate" aria-hidden="true">
        <svg viewBox="0 0 @F(ViewBox) @F(ViewBox)" focusable="false">
            <circle cx="50%" cy="50%" r="@F(Radius)" stroke-width="@F(Stroke)"
                    stroke-dasharray="@F(Circumference)" stroke-dashoffset="@F(DeterminateOffset)" />
        </svg>
    </div>
    <div class="pb-spinner__indeterminate" aria-hidden="true">
        <div class="pb-spinner__layer">
            <div class="pb-spinner__clipper pb-spinner__clipper--left">@Circle</div>
            <div class="pb-spinner__gap-patch">@Circle</div>
            <div class="pb-spinner__clipper pb-spinner__clipper--right">@Circle</div>
        </div>
    </div>
</div>

@code {
    private RenderFragment Circle => @<svg class="pb-spinner__graphic" viewBox="0 0 @F(ViewBox) @F(ViewBox)" focusable="false">
        <circle cx="50%" cy="50%" r="@F(Radius)" stroke-width="@F(Stroke)" stroke-dasharray="@F(Circumference)" stroke-dashoffset="@F(Circumference / 2)" />
    </svg>;

    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
