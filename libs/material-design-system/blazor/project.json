{
  "name": "design-system-blazor",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": ["design-tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "dotnet build PartoBita.DesignSystem.Blazor.csproj",
        "cwd": "libs/material-design-system/blazor"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/audit-colors.mts",
        "cwd": "{workspaceRoot}"
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "node libs/material-design-system/blazor/scripts/pack.mts",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/local-nuget-feed"]
    }
  },
  "tags": ["type:lib", "scope:design-system"]
}
