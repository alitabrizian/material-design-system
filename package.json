{
  "name": "workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "nx run-many -t build",
    "start": "node tools/scripts/serve-all.mts",
    "docs": "nx run blazor-design-system-docs:serve",
    "docs:angular": "nx run angular-design-system-docs:serve --host 0.0.0.0",
    "landing": "nx run design-system-landing:serve",
    "test:ui": "node tools/scripts/test-ui.mts",
    "test:ui:update": "node tools/scripts/test-ui.mts --update",
    "remotion:studio": "nx run design-system-remotion-videos:studio",
    "remotion:render": "nx run design-system-remotion-videos:render",
    "registry:up": "docker compose -f tools/registry/docker-compose.yml up -d",
    "registry:down": "docker compose -f tools/registry/docker-compose.yml down",
    "set-version": "node tools/scripts/set-version.mts",
    "release:local": "node tools/scripts/release.mts",
    "release:dry-run": "node tools/scripts/release.mts --dry-run"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@material/web": "2.5.0",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.526",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.8",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "@nx/js": "^21.5.0",
    "@playwright/test": "1.63.0",
    "@remotion/cli": "^4.0.526",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ng-packagr": "^22.2.3",
    "nx": "^21.5.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "libs/material-design-system/tokens"
  ]
}
