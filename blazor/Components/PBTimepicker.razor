@inherits WorkspaceFieldComponentBase
@inject Microsoft.JSInterop.IJSRuntime JS
@* mat-timepicker's field: an M3 form field with a native <input type="time"> and a trailing clock
   toggle that opens the browser's time picker. Attributes (value, min, max, step, disabled, @onchange…)
   go to the input. *@
<FormFieldFrame Appearance="Appearance" Label="@Label" LabelFor="@ControlId" HasError="HasError" HintText="@FieldHintText"
                Disabled="IsDisabledAttribute" Required="IsRequiredAttribute" Floating="true" Block="Block" Prefix="Prefix"
                ExtraClass="@("pb-datepicker " + UserClass)">
    <Control>
        <input @ref="input" class="pb-form-field__control" id="@ControlId" type="time"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@(FieldHintText is null ? null : ControlId + "-hint")"
               @attributes="Attrs" />
    </Control>
    <Suffix>
        <PBButton Variant="PBButtonVariant.Icon" Disabled="IsDisabledAttribute" aria-label="Open time picker" @onclick="OpenPickerAsync">
            <span class="material-icons" aria-hidden="true">schedule</span>
        </PBButton>
    </Suffix>
</FormFieldFrame>

@code {
    private ElementReference input;

    private async Task OpenPickerAsync() => await DesignSystemJs.InvokeVoidAsync(JS, "showPicker", input);
}
