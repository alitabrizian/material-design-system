@inherits WorkspaceComponentBase
@implements IDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
@if (Inline)
{
    <div class="pb-snackbar pb-snackbar--inline @UserClass" role="status" @attributes="Attrs">@Surface</div>
}
else
{
    <div @ref="container" class="pb-snackbar-container" popover="manual" aria-live="polite">
        @if (shown)
        {
            @* Figma Motion: after Open turns false it stays for its closing motion (--closing), then goes. *@
            <div @ref="surface" class="pb-snackbar @(Open ? null : "pb-snackbar--closing") @UserClass" role="status" @attributes="Attrs">@Surface</div>
        }
    </div>
}

@code {
    private RenderFragment Surface => @<text>
        <div class="pb-snackbar__label">@Label@ChildContent</div>
        @if (ActionLabel is not null)
        {
            <div class="pb-snackbar__actions">
                <PBButton @onclick="OnActionAsync">@ActionLabel</PBButton>
            </div>
        }
    </text>;
}
