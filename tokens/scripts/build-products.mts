/**
 * Builds the per-product brand colors (called by build-tokens.mts) from src/products.json: every consuming
 * project (product) has its own brand, selected with data-product="<id>" on <html> or any other element.
 *
 * For each product this emits one [data-product="<id>"] block with
 *   - the Material 3 primary, secondary and tertiary color roles (--md-sys-color-primary, -on-primary,
 *     -primary-container, -on-primary-container, -primary-fixed..., -inverse-primary, -surface-tint), generated by
 *     Angular Material's own theme generator (the `ng generate @angular/material:theme-color` schematic, which
 *     bundles @material/material-color-utilities) from the product's seed colors. Each value is
 *     light-dark(<light tone>, <dark tone>), so it follows the color-scheme the data-theme sets: the light themes
 *     get the light tones, the dark themes the dark ones. Neutral, surface and error roles stay the theme's.
 *   - the PartoBita brand aliases (--background-brand-*, --background-subtle-brand-*, --text-brand, --icon-brand,
 *     --icon-state-brand-selected, --border-brand-*, --border-state-brand-selected) and the icon-button Selected
 *     state, bound to the product's base palette in src/color-tokens.css.
 *
 * The default product's aliases are also set on :root, so a page with no data-product keeps the default brand
 * (and the Material roles of its data-theme). The selector also covers [data-product] [data-theme], so a nested
 * data-theme changes the mode and neutrals but keeps the product's brand.
 */

import fs from "node:fs";
import path from "node:path";
import { createRequire } from "node:module";

interface Seeds {
  primary: string;
  secondary?: string;
  tertiary?: string;
}

interface Product extends Seeds {
  id: string;
  name: string;
  default?: boolean;
  aliases?: string[];
  palette: string;
  dark?: Seeds;
}

export interface ProductInfo {
  id: string;
  name: string;
  aliases: string[];
  default: boolean;
  /** Seed colors (hex) and the generated primary role, light and dark. */
  seeds: { primary: string; secondary?: string; tertiary?: string };
  primary: { light: string; dark: string };
}

// The Material roles a product owns: the three accent families. Everything else stays the data-theme's.
const ROLE_FAMILIES = ["primary", "secondary", "tertiary"] as const;
const ROLES = [
  ...ROLE_FAMILIES.flatMap((f) => [
    f, `on-${f}`, `${f}-container`, `on-${f}-container`,
    `${f}-fixed`, `${f}-fixed-dim`, `on-${f}-fixed`, `on-${f}-fixed-variant`,
  ]),
  "inverse-primary", "surface-tint",
];

// PartoBita brand alias -> step of the product's base palette (the same steps as the per-brand aliases in
// src/color-tokens.css, e.g. --background-brand-partobita-hover is --brand-partobita-600).
const ALIASES: [string, number][] = [
  ["--background-brand-default", 500],
  ["--background-brand-hover", 600],
  ["--background-brand-press", 700],
  ["--background-subtle-brand-default", 50],
  ["--background-subtle-brand-hover", 100],
  ["--background-subtle-brand-press", 200],
  ["--text-brand", 500],
  ["--icon-brand", 500],
  ["--icon-state-brand-selected", 500],
  ["--border-brand-default", 500],
  ["--border-brand-hover", 600],
  ["--border-brand-press", 700],
  ["--border-state-brand-selected", 500],
  ["--icon-button-color-selected", 500],
  ["--icon-button-background-selected", 50],
];

type ThemeColor = {
  getColorPalettes(primary: string, secondary?: string, tertiary?: string): Record<string, unknown>;
  getMaterialDynamicScheme(...args: unknown[]): unknown;
  getAllSysVariablesCSS(light: unknown, dark: unknown): string;
};

function loadThemeColor(repoRoot: string, fail: (message: string) => never): ThemeColor {
  // Not in @angular/material's package exports, so it is loaded by path.
  const file = path.join(repoRoot, "node_modules/@angular/material/schematics/ng-generate/theme-color/index_bundled.js");
  if (!fs.existsSync(file)) fail(`could not find ${file}. Run 'npm install' at the workspace root first.`);
  return createRequire(import.meta.url)(file) as ThemeColor;
}

/** The --name: value pairs of src/color-tokens.css, to resolve seed and palette names. */
function readBaseColors(colorTokensCss: string): Map<string, string> {
  const colors = new Map<string, string>();
  for (const m of colorTokensCss.matchAll(/(--[a-z0-9-]+)\s*:\s*([^;]+);/g)) colors.set(m[1], m[2].trim());
  return colors;
}

export function buildProducts(
  packageRoot: string,
  repoRoot: string,
  colorTokensCss: string,
  fail: (message: string) => never
): { css: string; products: ProductInfo[] } {
  const config: { products: Product[] } = JSON.parse(fs.readFileSync(path.join(packageRoot, "src/products.json"), "utf8"));
  const products = config.products;
  const base = readBaseColors(colorTokensCss);
  const themeColor = loadThemeColor(repoRoot, fail);

  const defaults = products.filter((p) => p.default);
  if (defaults.length !== 1) fail(`src/products.json must mark exactly one product "default" (found ${defaults.length})`);
  const ids = new Set<string>();
  for (const p of products) {
    for (const id of [p.id, ...(p.aliases ?? [])]) {
      if (!/^[a-z][a-z0-9-]*$/.test(id)) fail(`product id "${id}" must be lowercase kebab case`);
      if (ids.has(id)) fail(`product id "${id}" is used twice in src/products.json`);
      ids.add(id);
    }
  }

  const hex = (value: string, where: string): string => {
    let v = value.trim();
    for (let depth = 0; depth < 10 && !v.startsWith("#"); depth++) {
      const name = v.startsWith("var(") ? v.slice(4, -1).trim() : v.startsWith("--") ? v : `--${v}`;
      const next = base.get(name);
      if (!next) fail(`${where}: "${value}" is neither a hex color nor a color in src/color-tokens.css`);
      v = next;
    }
    if (!/^#[0-9a-fA-F]{6}$/.test(v)) fail(`${where}: "${value}" resolves to ${v}, expected #rrggbb`);
    return v.toLowerCase();
  };

  /** Generated roles (role -> hex) for one mode, from Angular Material's light-dark() output. */
  const roles = (seeds: Seeds, where: string, mode: "light" | "dark"): Map<string, string> => {
    const palettes = themeColor.getColorPalettes(
      hex(seeds.primary, `${where}.primary`),
      seeds.secondary && hex(seeds.secondary, `${where}.secondary`),
      seeds.tertiary && hex(seeds.tertiary, `${where}.tertiary`)
    ) as Record<"primary" | "secondary" | "tertiary" | "neutral" | "neutralVariant", unknown>;
    const scheme = (isDark: boolean) =>
      themeColor.getMaterialDynamicScheme(
        palettes.primary, palettes.secondary, palettes.tertiary, palettes.neutral, palettes.neutralVariant, isDark, 0
      );
    const css = themeColor.getAllSysVariablesCSS(scheme(false), scheme(true));
    const out = new Map<string, string>();
    for (const m of css.matchAll(/--mat-sys-([a-z0-9-]+):\s*light-dark\((#[0-9a-f]{6}),\s*(#[0-9a-f]{6})\)/g)) {
      out.set(m[1], mode === "light" ? m[2] : m[3]);
    }
    const missing = ROLES.filter((role) => !out.has(role));
    if (missing.length) fail(`Angular Material's theme generator did not return ${missing.join(", ")}`);
    return out;
  };

  const css: string[] = [];
  const info: ProductInfo[] = [];
  for (const p of products) {
    const where = `src/products.json "${p.id}"`;
    for (const step of new Set(ALIASES.map(([, s]) => s))) {
      if (!base.has(`--${p.palette}-${step}`)) fail(`${where}: palette --${p.palette}-${step} is not in src/color-tokens.css`);
    }
    const light = roles(p, where, "light");
    const dark = roles({ ...p, ...p.dark }, `${where}.dark`, "dark");
    const selectors = [p.id, ...(p.aliases ?? [])].flatMap((id) => [`[data-product="${id}"]`, `[data-product="${id}"] [data-theme]`]);

    css.push(`/* ${p.name}${p.default ? " (default brand)" : ""} */`);
    css.push(`${(p.default ? [":root", ...selectors] : selectors).join(",\n")} {`);
    for (const [alias, step] of ALIASES) css.push(`  ${alias}: var(--${p.palette}-${step});`);
    css.push("}", "", `${selectors.join(",\n")} {`);
    // Light primary is the exact Figma brand color (the seed), not the generator's tone 40, so filled
    // components match the brand aliases (--background-brand-default). Dark keeps the generated tone.
    const lightPrimary = p.primary.startsWith("#") ? p.primary : `var(--${p.primary.replace(/^--/, "")})`;
    for (const role of ROLES) {
      const lightValue = role === "primary" || role === "surface-tint" ? lightPrimary : light.get(role);
      css.push(`  --md-sys-color-${role}: light-dark(${lightValue}, ${dark.get(role)});`);
    }
    css.push("}", "");

    info.push({
      id: p.id,
      name: p.name,
      aliases: p.aliases ?? [],
      default: !!p.default,
      seeds: {
        primary: hex(p.primary, where),
        ...(p.secondary && { secondary: hex(p.secondary, where) }),
        ...(p.tertiary && { tertiary: hex(p.tertiary, where) }),
      },
      primary: { light: hex(p.primary, where), dark: dark.get("primary")! },
    });
  }
  return { css: css.join("\n"), products: info };
}
