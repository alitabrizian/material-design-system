@page "/button-toggle"
@rendermode InteractiveServer

<PageTitle>Button Toggle · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Button Toggle">
        Button toggles are on/off toggles with the appearance of a button, grouped
        together to pick one option, or several, from a small set.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">
            Wrap toggles in a <code>PBButtonToggleGroup</code> and bind its <code>Value</code>.
            By default only one option can be selected at a time.
        </p>

        <ExampleCard Title="Basic button toggles" RazorCode="@(
@"<PBButtonToggleGroup Label=""Font style"" @bind-Value=""fontStyle"">
    <PBButtonToggle Value=""bold"">Bold</PBButtonToggle>
    <PBButtonToggle Value=""italic"">Italic</PBButtonToggle>
    <PBButtonToggle Value=""underline"">Underline</PBButtonToggle>
</PBButtonToggleGroup>")">
            <PBButtonToggleGroup Label="Font style" @bind-Value="fontStyle">
                <PBButtonToggle Value="bold">Bold</PBButtonToggle>
                <PBButtonToggle Value="italic">Italic</PBButtonToggle>
                <PBButtonToggle Value="underline">Underline</PBButtonToggle>
            </PBButtonToggleGroup>
            <p class="status">Chosen value: @(fontStyle ?? "—")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">
            Set <code>Multiple</code> and bind <code>Values</code> to let several options be selected.
            The checkmark on selected options can be hidden per mode.
        </p>

        <ExampleCard Title="Button toggle selection mode" RazorCode="@(
@"<PBCheckbox Label=""Hide Single Selection Indicator"" checked=""@hideSingle""
    @onchange=""@((ChangeEventArgs e) => hideSingle = (bool)e.Value!)"" />
<PBCheckbox Label=""Hide Multiple Selection Indicator"" checked=""@hideMultiple""
    @onchange=""@((ChangeEventArgs e) => hideMultiple = (bool)e.Value!)"" />

<h3>Single selection</h3>
<PBButtonToggleGroup Label=""Favorite color"" @bind-Value=""color""
    HideSingleSelectionIndicator=""hideSingle"">
    <PBButtonToggle Value=""red"">Red</PBButtonToggle>
    <PBButtonToggle Value=""green"">Green</PBButtonToggle>
    <PBButtonToggle Value=""blue"">Blue</PBButtonToggle>
</PBButtonToggleGroup>

<h3>Multiple selection</h3>
<PBButtonToggleGroup Label=""Ingredients"" Multiple @bind-Values=""ingredients""
    HideMultipleSelectionIndicator=""hideMultiple"">
    <PBButtonToggle Value=""flour"">Flour</PBButtonToggle>
    <PBButtonToggle Value=""eggs"">Eggs</PBButtonToggle>
    <PBButtonToggle Value=""sugar"">Sugar</PBButtonToggle>
</PBButtonToggleGroup>")">
            <div class="button-toggle-example">
                <div class="button-toggle-example__options">
                    <PBCheckbox Label="Hide Single Selection Indicator" checked="@hideSingle" @onchange="@((ChangeEventArgs e) => hideSingle = (bool)e.Value!)" />
                    <PBCheckbox Label="Hide Multiple Selection Indicator" checked="@hideMultiple" @onchange="@((ChangeEventArgs e) => hideMultiple = (bool)e.Value!)" />
                </div>

                <h3>Single selection</h3>
                <PBButtonToggleGroup Label="Favorite color" @bind-Value="color" HideSingleSelectionIndicator="hideSingle">
                    <PBButtonToggle Value="red">Red</PBButtonToggle>
                    <PBButtonToggle Value="green">Green</PBButtonToggle>
                    <PBButtonToggle Value="blue">Blue</PBButtonToggle>
                </PBButtonToggleGroup>

                <h3>Multiple selection</h3>
                <PBButtonToggleGroup Label="Ingredients" Multiple @bind-Values="ingredients" HideMultipleSelectionIndicator="hideMultiple">
                    <PBButtonToggle Value="flour">Flour</PBButtonToggle>
                    <PBButtonToggle Value="eggs">Eggs</PBButtonToggle>
                    <PBButtonToggle Value="sugar">Sugar</PBButtonToggle>
                </PBButtonToggleGroup>
            </div>
            <p class="status">Color: @(color ?? "—") · Ingredients: @(ingredients.Count == 0 ? "—" : string.Join(", ", ingredients))</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Disable a single option, or the whole group with <code>Disabled</code>.</p>

        <ExampleCard Title="Disabled" RazorCode="@(
@"<PBButtonToggleGroup Label=""Plan"" Value=""pro"">
    <PBButtonToggle Value=""free"">Free</PBButtonToggle>
    <PBButtonToggle Value=""pro"">Pro</PBButtonToggle>
    <PBButtonToggle Value=""team"" Disabled>Team</PBButtonToggle>
</PBButtonToggleGroup>

<PBButtonToggleGroup Label=""Plan"" Value=""pro"" Disabled>
    ...
</PBButtonToggleGroup>")">
            <div class="button-toggle-example">
                <PBButtonToggleGroup Label="Plan" Value="pro">
                    <PBButtonToggle Value="free">Free</PBButtonToggle>
                    <PBButtonToggle Value="pro">Pro</PBButtonToggle>
                    <PBButtonToggle Value="team" Disabled>Team</PBButtonToggle>
                </PBButtonToggleGroup>
                <PBButtonToggleGroup Label="Plan (disabled)" Value="pro" Disabled>
                    <PBButtonToggle Value="free">Free</PBButtonToggle>
                    <PBButtonToggle Value="pro">Pro</PBButtonToggle>
                    <PBButtonToggle Value="team">Team</PBButtonToggle>
                </PBButtonToggleGroup>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <h3>PBButtonToggleGroup</h3>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Value</code></td><td><code>string?</code></td><td>The selected toggle's <code>Value</code> in single-selection mode. Supports <code>@@bind-Value</code>.</td></tr>
                <tr><td><code>Multiple</code></td><td><code>bool</code></td><td>Allow several toggles to be selected at once.</td></tr>
                <tr><td><code>Values</code></td><td><code>IReadOnlyList&lt;string&gt;?</code></td><td>The selected values when <code>Multiple</code> is set. Supports <code>@@bind-Values</code>.</td></tr>
                <tr><td><code>Disabled</code></td><td><code>bool</code></td><td>Disables every toggle in the group.</td></tr>
                <tr><td><code>HideSingleSelectionIndicator</code></td><td><code>bool</code></td><td>Hides the checkmark on the selected toggle in single-selection mode.</td></tr>
                <tr><td><code>HideMultipleSelectionIndicator</code></td><td><code>bool</code></td><td>Hides the checkmark on selected toggles in multiple-selection mode.</td></tr>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Accessible name for the group (<code>aria-label</code>).</td></tr>
            </tbody>
        </table>

        <h3>PBButtonToggle</h3>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Value</code></td><td><code>string</code></td><td>Identifies this option within its group.</td></tr>
                <tr><td><code>Disabled</code></td><td><code>bool</code></td><td>Disables this option only.</td></tr>
                <tr><td><code>Checked</code></td><td><code>bool</code></td><td>Checked state when the toggle is used on its own, outside a group. Supports <code>@@bind-Checked</code>.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The toggle's label.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            In single-selection mode the group is a <code>radiogroup</code> of
            <code>radio</code> buttons with <code>aria-checked</code>: only the selected
            option is in the tab order, and the arrow keys move and select. With
            <code>Multiple</code> it is a <code>group</code> of buttons with
            <code>aria-pressed</code>, each reachable with Tab. Give every group a
            <code>Label</code>.
        </div>
    </section>
</div>

@code {
    private string? fontStyle;

    private bool hideSingle;
    private bool hideMultiple;
    private string? color;
    private IReadOnlyList<string> ingredients = [];
}
