@page "/button-toggle"
@rendermode InteractiveServer

<PageTitle>Button Toggle · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Button Toggle">
        A group of button toggles lets the user pick one option from a small,
        mutually exclusive set.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Only one option is treated as active at a time.</p>

        <ExampleCard Title="View mode" RazorCode="@(
@"@foreach (var option in viewOptions)
{
    <PBButtonToggle Pressed=""@(option == selectedView)"" @onclick=""() => selectedView = option"">@option</PBButtonToggle>
}")">
            <span style="display:inline-flex; gap:0.5rem;">
                @foreach (var option in viewOptions)
                {
                    <PBButtonToggle Pressed="@(option == selectedView)" @onclick="() => selectedView = option">@option</PBButtonToggle>
                }
            </span>
            <p class="status">Selected: @selectedView</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Pressed</code></td><td><code>bool</code></td><td>Whether this toggle is the active selection. Drives both the visual (tonal fill) and <code>aria-pressed</code>.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The toggle's label content.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;button&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>aria-pressed</code> reflects the real <code>Pressed</code> parameter,
            so assistive technology correctly announces the active option.
        </div>
    </section>
</div>

@code {
    private static readonly string[] viewOptions = ["List", "Grid", "Board"];
    private string selectedView = viewOptions[0];
}
