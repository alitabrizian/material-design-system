@page "/form-field"
@rendermode InteractiveServer

<PageTitle>Form Field · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Form Field">
        A form field pairs a label with a single form control, giving the control
        an accessible name.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">The label is associated with the wrapped control.</p>

        <ExampleCard Title="Wrapping an input" RazorCode="@(
@"<PBFormField Label=""Display name"">
    <input placeholder=""Jane Doe"" />
</PBFormField>")">
            <PBFormField Label="Display name">
                <input placeholder="Jane Doe" />
            </PBFormField>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Form field works with any control as child content.</p>

        <ExampleCard Title="Wrapping a select" RazorCode="@(
@"<PBFormField Label=""Role"">
    <select>
        <option>Admin</option>
        <option>Editor</option>
        <option>Viewer</option>
    </select>
</PBFormField>")">
            <PBFormField Label="Role">
                <select>
                    <option>Admin</option>
                    <option>Editor</option>
                    <option>Viewer</option>
                </select>
            </PBFormField>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered inside the wrapping <code>&lt;label&gt;</code>.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The wrapped form control.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The label and control are wrapped in one <code>&lt;label&gt;</code>, which
            associates them without needing a matching <code>for</code>/<code>id</code>
            pair.
        </div>
    </section>
</div>
