@page "/form-field"
@rendermode InteractiveServer

<PageTitle>Form Field · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Form Field</h2>
            </div>
            <div>
                <span>Combine labels, controls, and hints.</span>
            </div>
        </div>

        <p class="intro">
            A form field pairs a label with a single form control, giving the control
            an accessible name.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Wrapping an input</legend>
                <p class="field-hint">The label is associated with the wrapped control.</p>
                <FormField Label="Display name">
                    <input placeholder="Jane Doe" />
                </FormField>
            </fieldset>

            <fieldset class="playground-field">
                <legend>Wrapping a select</legend>
                <p class="field-hint">Form field works with any control as child content.</p>
                <FormField Label="Role">
                    <select>
                        <option>Admin</option>
                        <option>Editor</option>
                        <option>Viewer</option>
                    </select>
                </FormField>
            </fieldset>

        </div>
    </div>
</div>
