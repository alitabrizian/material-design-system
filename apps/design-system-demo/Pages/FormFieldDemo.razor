@page "/form-field"
@rendermode InteractiveServer

<PageTitle>Form Field · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Form Field">
        PBFormField wraps a native control (input, textarea or select) with the M3 text-field
        chrome: floating label, fill or outline
        container, hint and error text, and prefix/suffix icons.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">The two appearances, fill (default) and outline.</p>

        <ExampleCard Title="Form field appearance variants" RazorCode="@(
@"<PBFormField Label=""Fill form field"" LabelFor=""fill"" SupportingText=""Hint"">
    <input id=""fill"" placeholder=""Placeholder"" />
</PBFormField>
<PBFormField Appearance=""PBFormFieldAppearance.Outline"" Label=""Outline form field""
             LabelFor=""outline"" SupportingText=""Hint"">
    <input id=""outline"" placeholder=""Placeholder"" />
</PBFormField>")">
            <div class="demo-row">
                <PBFormField Label="Fill form field" LabelFor="ff-fill" SupportingText="Hint">
                    <input id="ff-fill" placeholder="Placeholder" />
                </PBFormField>
                <PBFormField Appearance="PBFormFieldAppearance.Outline" Label="Outline form field" LabelFor="ff-outline" SupportingText="Hint">
                    <input id="ff-outline" placeholder="Placeholder" />
                </PBFormField>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Prefix and suffix icons, a textarea and a native select.</p>

        <ExampleCard Title="Prefix, suffix, textarea and select" RazorCode="@(
@"<PBFormField Label=""Amount"" LabelFor=""amount"">
    <Prefix><span class=""material-icons"">attach_money</span></Prefix>
    <Suffix><span class=""pb-icon-slot""><span class=""material-icons"">info</span></span></Suffix>
    <ChildContent><input id=""amount"" type=""number"" /></ChildContent>
</PBFormField>
<PBFormField Label=""Leave a comment"" LabelFor=""comment"">
    <textarea id=""comment""></textarea>
</PBFormField>
<PBFormField Label=""Role"" LabelFor=""role"">
    <select id=""role""><option>Admin</option><option>Editor</option></select>
</PBFormField>")">
            <div class="demo-row">
                <PBFormField Label="Amount" LabelFor="ff-amount">
                    <Prefix><span class="material-icons">attach_money</span></Prefix>
                    <Suffix><span class="pb-icon-slot"><span class="material-icons">info</span></span></Suffix>
                    <ChildContent><input id="ff-amount" type="number" /></ChildContent>
                </PBFormField>
                <PBFormField Label="Leave a comment" LabelFor="ff-comment">
                    <textarea id="ff-comment"></textarea>
                </PBFormField>
                <PBFormField Label="Role" LabelFor="ff-role">
                    <select id="ff-role">
                        <option>Admin</option>
                        <option>Editor</option>
                        <option>Viewer</option>
                    </select>
                </PBFormField>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Floating label.</td></tr>
                <tr><td><code>LabelFor</code></td><td><code>string?</code></td><td>The projected control's <code>id</code>, for the label's <code>for</code>.</td></tr>
                <tr><td><code>Appearance</code></td><td><code>PBFormFieldAppearance</code></td><td><code>Fill</code> (default) or <code>Outline</code>.</td></tr>
                <tr><td><code>SupportingText</code> / <code>ErrorText</code></td><td><code>string?</code></td><td>Hint / error text under the field. An error colors the field.</td></tr>
                <tr><td><code>Prefix</code> / <code>Suffix</code></td><td><code>RenderFragment?</code></td><td>matIconPrefix / matIconSuffix.</td></tr>
                <tr><td><code>Block</code></td><td><code>bool</code></td><td>Stretches the field to its container's width.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The native control.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The label is a real <code>&lt;label for&gt;</code> tied to the control's id; hint and
            error text sit right below it (errors use <code>role="alert"</code>).
        </div>
    </section>
</div>
