@page "/dialog"
@rendermode InteractiveServer

<PageTitle>Dialog · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Dialog</h1>
        <p class="intro">
            A dialog interrupts the current flow to focus attention on a single task
            or piece of information.
        </p>
    </header>

    <section class="doc-section">
        <h2>Confirmation dialog</h2>
        <p class="field-hint">Toggle the dialog with the button below.</p>

        <div class="doc-example">
            <PBButton @onclick="() => isOpen = !isOpen">@(isOpen ? "Hide dialog" : "Show dialog")</PBButton>

            @if (isOpen)
            {
                <PBDialog Label="Discard changes?">
                    <p style="margin:0 0 0.75rem;">Your edits have not been saved.</p>
                    <span style="display:inline-flex; gap:0.5rem;">
                        <PBButton @onclick="() => isOpen = false">Cancel</PBButton>
                        <PBButton @onclick="() => isOpen = false">Discard</PBButton>
                    </span>
                </PBDialog>
            }
        </div>

        <CodeSnippet Code="@(
@"<PBDialog Label=""Discard changes?"">
    <p>Your edits have not been saved.</p>
    <PBButton @onclick=""Cancel"">Cancel</PBButton>
    <PBButton @onclick=""Discard"">Discard</PBButton>
</PBDialog>")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Rendered as the dialog's <code>&lt;h2&gt;</code> heading.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The dialog's body content and actions.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;dialog open&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native <code>&lt;dialog&gt;</code> element, always <code>open</code>
            while present. The host page is responsible for mounting/unmounting it and
            for moving focus into the dialog when it appears and back to the trigger
            when it closes.
        </div>
    </section>
</div>

@code {
    private bool isOpen = true;
}
