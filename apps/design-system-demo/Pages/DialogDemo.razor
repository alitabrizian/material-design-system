@page "/dialog"
@rendermode InteractiveServer

<PageTitle>Dialog · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Dialog">
        PBDialog opens a modal dialog with M3 styling and focus management, like Angular
        Material's <code>MatDialog</code>: a native <code>&lt;dialog&gt;</code> in the top layer
        with a scrim, focus trap and Escape to close.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Bind <code>Open</code>. <code>Label</code> is the title, child content the body, <code>Actions</code> the button row.</p>

        <ExampleCard Title="Dialog with title, content and actions" RazorCode="@(
@"<PBButton Variant=""PBButtonVariant.Outlined"" @onclick=""() => open = true"">Open dialog</PBButton>

<PBDialog Label=""Delete file"" @bind-Open=""open"">
    <ChildContent>Would you like to delete cat.jpeg?</ChildContent>
    <Actions>
        <PBButton @onclick=""() => Close(false)"">No</PBButton>
        <PBButton @onclick=""() => Close(true)"">Ok</PBButton>
    </Actions>
</PBDialog>")">
            <PBButton Variant="PBButtonVariant.Outlined" @onclick="() => open = true">Open dialog</PBButton>
            <p class="status">Result: @(result ?? "—")</p>

            <PBDialog Label="Delete file" @bind-Open="open">
                <ChildContent>Would you like to delete cat.jpeg?</ChildContent>
                <Actions>
                    <PBButton @onclick="() => Close(false)">No</PBButton>
                    <PBButton @onclick="() => Close(true)">Ok</PBButton>
                </Actions>
            </PBDialog>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">With <code>DisableClose</code>, Escape and backdrop clicks are ignored; only an action closes it.</p>

        <ExampleCard Title="Dialog that requires an action" RazorCode="@(
@"<PBDialog Label=""Discard changes?"" DisableClose @bind-Open=""confirmOpen"">
    <ChildContent>Your unsaved edits will be lost.</ChildContent>
    <Actions>
        <PBButton @onclick=""() => confirmOpen = false"">Cancel</PBButton>
        <PBButton Variant=""PBButtonVariant.Filled"" @onclick=""() => confirmOpen = false"">Discard</PBButton>
    </Actions>
</PBDialog>")">
            <PBButton Variant="PBButtonVariant.Tonal" @onclick="() => confirmOpen = true">Discard draft</PBButton>
            <PBDialog Label="Discard changes?" DisableClose @bind-Open="confirmOpen">
                <ChildContent>Your unsaved edits will be lost. This can't be undone.</ChildContent>
                <Actions>
                    <PBButton @onclick="() => confirmOpen = false">Cancel</PBButton>
                    <PBButton Variant="PBButtonVariant.Filled" @onclick="() => confirmOpen = false">Discard</PBButton>
                </Actions>
            </PBDialog>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">The dialog surface rendered in place (<code>Inline</code>), for previews and documentation.</p>

        <ExampleCard Title="Inline preview" RazorCode="@(
@"<PBDialog Label=""Use location service?"" Inline>
    <ChildContent>Let the app help determine your location.</ChildContent>
    <Actions><PBButton>Disagree</PBButton><PBButton>Agree</PBButton></Actions>
</PBDialog>")">
            <div style="position:relative;min-height:220px">
                <PBDialog Label="Use location service?" Inline style="position:static">
                    <ChildContent>Let the app help determine your location. This means sending anonymous location data, even when no apps are running.</ChildContent>
                    <Actions><PBButton>Disagree</PBButton><PBButton>Agree</PBButton></Actions>
                </PBDialog>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Open</code></td><td><code>bool</code></td><td>Shows the dialog modally. Supports <code>@@bind-Open</code>.</td></tr>
                <tr><td><code>Label</code> / <code>Title</code></td><td><code>string?</code> / <code>RenderFragment?</code></td><td>mat-dialog-title (headline-small).</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>mat-dialog-content.</td></tr>
                <tr><td><code>Actions</code></td><td><code>RenderFragment?</code></td><td>mat-dialog-actions (end-aligned).</td></tr>
                <tr><td><code>DisableClose</code></td><td><code>bool</code></td><td>Ignores Escape and backdrop clicks.</td></tr>
                <tr><td><code>Inline</code></td><td><code>bool</code></td><td>Renders the surface in place, non-modal.</td></tr>
                <tr><td><code>CloseAsync()</code></td><td>method</td><td>Closes the dialog from code.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            A native modal <code>&lt;dialog&gt;</code>: the rest of the page is inert, focus moves into
            the dialog and is trapped there, and it is labelled by its title. Escape closes it unless
            <code>DisableClose</code> is set.
        </div>
    </section>
</div>

@code {
    private bool open;
    private bool confirmOpen;
    private string? result;

    private void Close(bool ok)
    {
        result = ok ? "Deleted" : "Kept";
        open = false;
    }
}
