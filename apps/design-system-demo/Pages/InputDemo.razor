@page "/input"
@rendermode InteractiveServer

<PageTitle>Input · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Input</h1>
        <p class="intro">The input component captures a single line of text from the user.</p>
    </header>

    <section class="doc-section">
        <h2>Default</h2>
        <p class="field-hint">Typing updates the status below.</p>

        <div class="doc-example">
            <PBInput Label="Email address" placeholder="you@example.com" value="@email" @oninput="@((ChangeEventArgs e) => email = e.Value?.ToString())" />
            <span class="status">Value: @(string.IsNullOrEmpty(email) ? "—" : email)</span>
        </div>

        <CodeSnippet Code="@(
@"<PBInput Label=""Email address""
    placeholder=""you@example.com""
    value=""@email""
    @oninput=""@((ChangeEventArgs e) => email = e.Value?.ToString())"" />")" />
    </section>

    <section class="doc-section">
        <h2>Disabled</h2>
        <p class="field-hint">A disabled input cannot be edited.</p>

        <div class="doc-example">
            <PBInput Label="Locked field" value="Read only" disabled />
        </div>

        <CodeSnippet Code="@(@"<PBInput Label=""Locked field"" value=""Read only"" disabled />")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Rendered as <code>aria-label</code> on the input.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>Label</code> is applied as <code>aria-label</code> rather than a
            visible <code>&lt;label&gt;</code> element; pair it with
            <code>PBFormField</code> when a visible label is required.
        </div>
    </section>
</div>

@code {
    private string? email;
}
