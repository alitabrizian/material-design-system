@page "/input"
@rendermode InteractiveServer

<PageTitle>Input · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Input">The input component captures a single line of text from the user.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Typing updates the status below.</p>

        <ExampleCard Title="Default" RazorCode="@(
@"<PBInput Label=""Email address""
    placeholder=""you@example.com""
    value=""@email""
    @oninput=""@((ChangeEventArgs e) => email = e.Value?.ToString())"" />")">
            <PBInput Label="Email address" placeholder="you@example.com" value="@email" @oninput="@((ChangeEventArgs e) => email = e.Value?.ToString())" />
            <p class="status">Value: @(string.IsNullOrEmpty(email) ? "—" : email)</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled input cannot be edited.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBInput Label=""Locked field"" value=""Read only"" disabled />")">
            <PBInput Label="Locked field" value="Read only" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Supporting text renders below the field to give extra context.</p>

        <ExampleCard Title="With supporting text" RazorCode="@(@"<PBInput Label=""Username"" SupportingText=""This is visible to other members."" />")">
            <PBInput Label="Username" SupportingText="This is visible to other members." />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Setting <code>ErrorText</code> switches the field into its error state (error-colored underline, label, and hint text) and takes priority over <code>SupportingText</code>.</p>

        <ExampleCard Title="With error text" RazorCode="@(@"<PBInput Label=""Email address"" value=""not-an-email"" ErrorText=""Enter a valid email address."" />")">
            <PBInput Label="Email address" value="not-an-email" ErrorText="Enter a valid email address." />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>The floating label shown inside the field.</td></tr>
                <tr><td><code>SupportingText</code></td><td><code>string?</code></td><td>Helper text rendered below the field.</td></tr>
                <tr><td><code>ErrorText</code></td><td><code>string?</code></td><td>When set, replaces supporting text and switches the field to its error state.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>Label</code> renders as a real, visible <code>&lt;span&gt;</code> tied
            to the input by DOM proximity and doubles as the input's
            <code>aria-label</code>, so assistive technology announces it even while
            it is visually floating inside the field.
        </div>
    </section>
</div>

@code {
    private string? email;
}
