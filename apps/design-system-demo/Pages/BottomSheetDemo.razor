@page "/bottom-sheet"
@rendermode InteractiveServer

<PageTitle>Bottom Sheet · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Bottom Sheet</h2>
            </div>
            <div>
                <span>Present actions in a mobile-friendly panel.</span>
            </div>
        </div>

        <p class="intro">
            A bottom sheet surfaces a focused set of actions or information without
            leaving the current page. Toggle the button below to show or hide it.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Action sheet</legend>
                <p class="field-hint">A bottom sheet listing a short set of actions.</p>
                <Button @onclick="() => isOpen = !isOpen">@(isOpen ? "Hide sheet" : "Show sheet")</Button>

                @if (isOpen)
                {
                    <BottomSheet Label="Share options">
                        <List>
                            <li>Copy link</li>
                            <li>Send in a message</li>
                            <li>Share to social</li>
                        </List>
                    </BottomSheet>
                }
            </fieldset>

        </div>
    </div>
</div>

@code {
    private bool isOpen = true;
}
