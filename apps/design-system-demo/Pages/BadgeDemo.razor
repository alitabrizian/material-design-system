@page "/badge"
@rendermode InteractiveServer

<PageTitle>Badge · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Badge">
        Badges are small status descriptors for UI elements: a small circle with a count or short
        text pinned to a corner of the element it annotates.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Wrap the annotated element in <code>PBBadge</code> and set <code>Content</code>. Use <code>Position</code>, <code>Size</code> and <code>Overlap</code> to place and size it.</p>

        <ExampleCard Title="Badge overview" RazorCode="@(
@"<PBBadge Content=""4"" Overlap=""false"">Text with a badge</PBBadge>
<PBBadge Content=""1"" Size=""PBBadgeSize.Small"" Overlap=""false"">Text with small badge</PBBadge>
<PBBadge Content=""1"" Size=""PBBadgeSize.Large"" Overlap=""false"">Text with large badge</PBBadge>

<PBBadge Content=""8"" Position=""PBBadgePosition.AboveBefore"" Description=""8 notifications"">
    <PBButton Variant=""PBButtonVariant.Elevated"">Action</PBButton>
</PBBadge>

<PBBadge Content=""7"" Hidden=""@hidden"">
    <PBButton Variant=""PBButtonVariant.Elevated"" @onclick=""() => hidden = !hidden"">Toggle badge</PBButton>
</PBBadge>

<PBBadge Content=""15"" Description=""15 unread"">
    <PBIcon>home</PBIcon>
</PBBadge>")">
            <div class="badge-overview-grid">
                <div class="badge-overview-row">
                    <PBBadge Content="4" Overlap="false">Text with a badge</PBBadge>
                </div>
                <div class="badge-overview-row">
                    <PBBadge Content="1" Size="PBBadgeSize.Small" Overlap="false">Text with small badge</PBBadge>
                </div>
                <div class="badge-overview-row">
                    <PBBadge Content="1" Size="PBBadgeSize.Large" Overlap="false">Text with large badge</PBBadge>
                </div>
                <div class="badge-overview-row">
                    <span>Button with a badge on the left</span>
                    <PBBadge Content="8" Position="PBBadgePosition.AboveBefore" Description="8 notifications">
                        <PBButton Variant="PBButtonVariant.Elevated">Action</PBButton>
                    </PBBadge>
                </div>
                <div class="badge-overview-row">
                    <span>Button toggles badge visibility</span>
                    <PBBadge Content="7" Hidden="hidden">
                        <PBButton Variant="PBButtonVariant.Elevated" @onclick="() => hidden = !hidden">Toggle badge</PBButton>
                    </PBBadge>
                </div>
                <div class="badge-overview-row">
                    <span>Icon with a badge</span>
                    <PBBadge Content="15" Description="15 unread messages">
                        <PBIcon>home</PBIcon>
                    </PBBadge>
                </div>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Content</code></td><td><code>string?</code></td><td>The badge text.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The element the badge is attached to.</td></tr>
                <tr><td><code>Position</code></td><td><code>PBBadgePosition</code></td><td><code>AboveAfter</code> (default), <code>AboveBefore</code>, <code>BelowAfter</code>, <code>BelowBefore</code>.</td></tr>
                <tr><td><code>Size</code></td><td><code>PBBadgeSize</code></td><td><code>Small</code> (6px dot), <code>Medium</code> (default, 16px) or <code>Large</code> (16px).</td></tr>
                <tr><td><code>Overlap</code></td><td><code>bool</code></td><td>Overlaps the host's corner (default); turn off for text hosts.</td></tr>
                <tr><td><code>Hidden</code>, <code>Disabled</code></td><td><code>bool</code></td><td>Hides the badge / dims it (error at 38%).</td></tr>
                <tr><td><code>Description</code></td><td><code>string?</code></td><td>Screen-reader text.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The badge itself is <code>aria-hidden</code>; give it a <code>Description</code> so
            screen readers announce what the count means.
        </div>
    </section>
</div>

@code {
    private bool hidden;
}
