@page "/badge"
@rendermode InteractiveServer

<PageTitle>Badge · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Badge</h2>
            </div>
            <div>
                <span>Show a compact value or status indicator.</span>
            </div>
        </div>

        <p class="intro">
            A badge is a small label attached to another element to draw attention to a
            count, a status, or a piece of contextual information.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Text badge</legend>
                <p class="field-hint">Use a short word to communicate status.</p>
                <Badge>New</Badge>
            </fieldset>

            <fieldset class="playground-field">
                <legend>Numeric badge</legend>
                <p class="field-hint">Use a number to communicate a count.</p>
                <Badge>12</Badge>
            </fieldset>

            <fieldset class="playground-field">
                <legend>Badge next to an action</legend>
                <p class="field-hint">Badges are commonly paired with a button or icon.</p>
                <span style="display:inline-flex; align-items:center; gap:0.5rem;">
                    <Button>Inbox</Button>
                    <Badge>@unreadCount</Badge>
                </span>
            </fieldset>

        </div>
    </div>
</div>

@code {
    private int unreadCount = 4;
}
