@page "/expansion-panel"
@rendermode InteractiveServer

<PageTitle>Expansion Panel · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Expansion Panel">
        PBExpansionPanel provides an expandable details-summary view; several panels
        form an accordion.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">A panel with a title and description. Bind <code>Expanded</code> to control it.</p>

        <ExampleCard Title="Basic expansion panel" RazorCode="@(
@"<PBAccordion>
    <PBExpansionPanel Label=""This is the expansion title"" @bind-Expanded=""open"">
        <Description>This is a summary of the content</Description>
        <ChildContent>This is the primary content of the panel.</ChildContent>
    </PBExpansionPanel>
    <PBExpansionPanel Label=""Self aware panel"">
        <Description>Currently I am @(open ? ""open"" : ""closed"")</Description>
        <ChildContent>I'm visible because I am open</ChildContent>
    </PBExpansionPanel>
</PBAccordion>")">
            <PBAccordion>
                <PBExpansionPanel Label="This is the expansion title" @bind-Expanded="firstOpen">
                    <Description>This is a summary of the content</Description>
                    <ChildContent><p>This is the primary content of the panel.</p></ChildContent>
                </PBExpansionPanel>
                <PBExpansionPanel Label="Self aware panel" @bind-Expanded="secondOpen">
                    <Description>Currently I am @(secondOpen ? "open" : "closed")</Description>
                    <ChildContent><p>I'm visible because I am open</p></ChildContent>
                </PBExpansionPanel>
            </PBAccordion>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">An accordion that lets several panels stay open (<code>Multi</code>), with an action row and a disabled panel.</p>

        <ExampleCard Title="Accordion with actions" RazorCode="@(
@"<PBAccordion Multi>
    <PBExpansionPanel Label=""Personal data"">
        <ChildContent>...</ChildContent>
        <Actions><PBButton>Next</PBButton></Actions>
    </PBExpansionPanel>
    <PBExpansionPanel Label=""Destination"">...</PBExpansionPanel>
    <PBExpansionPanel Label=""Disabled"" Disabled />
</PBAccordion>")">
            <PBAccordion Multi>
                <PBExpansionPanel Label="Personal data">
                    <Description>Type your name and age</Description>
                    <ChildContent>
                        <div class="demo-row">
                            <PBInput Label="First name" />
                            <PBInput Label="Age" type="number" />
                        </div>
                    </ChildContent>
                    <Actions><PBButton>Next</PBButton></Actions>
                </PBExpansionPanel>
                <PBExpansionPanel Label="Destination">
                    <Description>Type the country name</Description>
                    <ChildContent><PBInput Label="Country" /></ChildContent>
                </PBExpansionPanel>
                <PBExpansionPanel Label="Disabled panel" Disabled>
                    <ChildContent>Not reachable.</ChildContent>
                </PBExpansionPanel>
            </PBAccordion>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code> / <code>Title</code></td><td><code>string?</code> / <code>RenderFragment?</code></td><td>Header title.</td></tr>
                <tr><td><code>Description</code></td><td><code>RenderFragment?</code></td><td>Secondary header text.</td></tr>
                <tr><td><code>Expanded</code></td><td><code>bool</code></td><td>Supports <code>@@bind-Expanded</code>.</td></tr>
                <tr><td><code>Actions</code></td><td><code>RenderFragment?</code></td><td>Action row under a divider.</td></tr>
                <tr><td><code>Disabled</code>, <code>HideToggle</code></td><td><code>bool</code></td><td>Disables the header / hides the chevron.</td></tr>
                <tr><td><code>PBAccordion.Multi</code></td><td><code>bool</code></td><td>Allows several expanded panels at once.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The header is a button with <code>aria-expanded</code> and <code>aria-controls</code>;
            the body is a <code>region</code> labelled by the header and is inert while collapsed.
        </div>
    </section>
</div>

@code {
    private bool firstOpen = true;
    private bool secondOpen;
}
