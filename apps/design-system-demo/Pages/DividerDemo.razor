@page "/divider"
@rendermode InteractiveServer

<PageTitle>Divider · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Divider">A divider is a thin line that groups content into clear sections.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Use a divider to separate unrelated content.</p>

        <ExampleCard Title="Between two sections" RazorCode="@(
@"<p>Account settings</p>
<PBDivider />
<p>Notification preferences</p>")">
            <p style="margin:0;">Account settings</p>
            <PBDivider />
            <p style="margin:0;">Notification preferences</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;hr&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native <code>&lt;hr&gt;</code>, which is announced as a
            separator by assistive technology with no extra markup needed.
        </div>
    </section>
</div>
