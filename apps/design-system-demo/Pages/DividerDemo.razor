@page "/divider"
@rendermode InteractiveServer

<PageTitle>Divider · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Divider</h2>
            </div>
            <div>
                <span>Separate related content sections.</span>
            </div>
        </div>

        <p class="intro">
            A divider is a thin line that groups content into clear sections.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Between two sections</legend>
                <p class="field-hint">Use a divider to separate unrelated content.</p>
                <p style="margin:0;">Account settings</p>
                <Divider />
                <p style="margin:0;">Notification preferences</p>
            </fieldset>

        </div>
    </div>
</div>
