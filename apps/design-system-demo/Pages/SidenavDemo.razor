@page "/sidenav"
@rendermode InteractiveServer

<PageTitle>Sidenav · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Sidenav</h2>
            </div>
            <div>
                <span>Navigate through a vertical side panel.</span>
            </div>
        </div>

        <p class="intro">
            A sidenav is a vertical panel used to navigate between the sections of an
            application.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Section navigation</legend>
                <p class="field-hint">A compact vertical list of links.</p>
                <Sidenav Label="Workspace sections" style="width:14rem; border:1px solid var(--catalog-line); border-radius:0.5rem; padding:0.5rem;">
                    <List>
                        <li>Overview</li>
                        <li>Members</li>
                        <li>Billing</li>
                        <li>Settings</li>
                    </List>
                </Sidenav>
            </fieldset>

        </div>
    </div>
</div>
