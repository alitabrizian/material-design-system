@page "/tabs"
@rendermode InteractiveServer

<PageTitle>Tabs · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Tabs">
        Tabs organize related content into separate views that share the same
        context.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Selecting a tab swaps the panel below.</p>

        <ExampleCard Title="Account settings" RazorCode="@(
@"<PBTabs>
    @foreach (var tab in tabs)
    {
        <button type=""button"" role=""tab"" class=""@TabClass(tab)""
            aria-selected=""@(tab == activeTab)"" @onclick=""() => activeTab = tab"">@tab</button>
    }
</PBTabs>")">
            <PBTabs>
                @foreach (var tab in tabs)
                {
                    <button type="button" role="tab" class="@TabClass(tab)"
                        aria-selected="@(tab == activeTab ? "true" : "false")" @onclick="() => activeTab = tab">@tab</button>
                }
            </PBTabs>
            <div role="tabpanel" style="padding-top:0.75rem;">
                @switch (activeTab)
                {
                    case "Profile":
                        <p style="margin:0;">Update your name, photo, and bio.</p>
                        break;
                    case "Security":
                        <p style="margin:0;">Manage your password and two-factor authentication.</p>
                        break;
                    default:
                        <p style="margin:0;">Manage connected apps and API tokens.</p>
                        break;
                }
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The tab controls.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;div role="tablist"&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The container has <code>role="tablist"</code>, each tab has
            <code>role="tab"</code> and <code>aria-selected</code>, and the content
            region has <code>role="tabpanel"</code>.
        </div>
    </section>
</div>

@code {
    private static readonly string[] tabs = ["Profile", "Security", "Integrations"];
    private string activeTab = tabs[0];

    private string TabClass(string tab) => tab == activeTab ? "workspace-tab workspace-tab--active" : "workspace-tab";
}
