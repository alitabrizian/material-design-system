@page "/tabs"
@rendermode InteractiveServer

<PageTitle>Tabs · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Tabs">
        PBTabs organizes content into separate views where only one view is visible at a time,
        like Angular Material's <code>mat-tab-group</code>. The active indicator slides between
        tabs.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Each <code>PBTab</code>'s child content is its panel. Tabs stretch to fill the header by default.</p>

        <ExampleCard Title="Basic use of the tab group" RazorCode="@(
@"<PBTabs @bind-SelectedIndex=""selected"">
    <PBTab Label=""First"">Content 1</PBTab>
    <PBTab Label=""Second"">Content 2</PBTab>
    <PBTab Label=""Third"">Content 3</PBTab>
</PBTabs>")">
            <PBTabs Label="Basic tabs" @bind-SelectedIndex="selected">
                <PBTab Label="First"><p style="padding:16px 0">Content 1</p></PBTab>
                <PBTab Label="Second"><p style="padding:16px 0">Content 2</p></PBTab>
                <PBTab Label="Third"><p style="padding:16px 0">Content 3</p></PBTab>
            </PBTabs>
            <p class="status">Selected index: @selected</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Icons in the labels, a disabled tab and start-aligned, non-stretched tabs.</p>

        <ExampleCard Title="Icons, disabled tab, alignment" RazorCode="@(
@"<PBTabs Stretch=""false"">
    <PBTab Label=""Flights"">
        <Icon><span class=""material-icons"">flight</span></Icon>
        <ChildContent>...</ChildContent>
    </PBTab>
    <PBTab Label=""Hotels"">...</PBTab>
    <PBTab Label=""Cars"" Disabled>...</PBTab>
</PBTabs>")">
            <PBTabs Label="Travel" Stretch="false">
                <PBTab Label="Flights">
                    <Icon><span class="material-icons">flight</span></Icon>
                    <ChildContent><p style="padding:16px 0">Search flights.</p></ChildContent>
                </PBTab>
                <PBTab Label="Hotels">
                    <Icon><span class="material-icons">hotel</span></Icon>
                    <ChildContent><p style="padding:16px 0">Search hotels.</p></ChildContent>
                </PBTab>
                <PBTab Label="Cars" Disabled>
                    <Icon><span class="material-icons">directions_car</span></Icon>
                    <ChildContent><p style="padding:16px 0">Search cars.</p></ChildContent>
                </PBTab>
            </PBTabs>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>SelectedIndex</code></td><td><code>int</code></td><td>The active tab. Supports <code>@@bind-SelectedIndex</code>.</td></tr>
                <tr><td><code>Stretch</code></td><td><code>bool</code></td><td>Tabs share the header width (default <code>true</code>, like mat-stretch-tabs).</td></tr>
                <tr><td><code>Align</code></td><td><code>PBTabsAlign</code></td><td><code>Start</code>, <code>Center</code> or <code>End</code> for non-stretched tabs.</td></tr>
                <tr><td><code>PBTab.Label</code> / <code>LabelContent</code></td><td><code>string?</code> / <code>RenderFragment?</code></td><td>The tab label.</td></tr>
                <tr><td><code>PBTab.Icon</code>, <code>.Disabled</code></td><td><code>RenderFragment?</code>, <code>bool</code></td><td>Leading icon / disabled tab.</td></tr>
                <tr><td><code>PBTab.ChildContent</code></td><td><code>RenderFragment?</code></td><td>The panel shown when the tab is active.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The header is a <code>tablist</code> of <code>tab</code>s with <code>aria-selected</code>
            and <code>aria-controls</code>; the content is a <code>tabpanel</code>. Only the active
            tab is in the tab order; Arrow keys, Home and End move focus between tabs and Enter or
            Space activates, as in mat-tab-group.
        </div>
    </section>
</div>

@code {
    private int selected;
}
