@page "/tabs"
@rendermode InteractiveServer

<PageTitle>Tabs · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Tabs</h2>
            </div>
            <div>
                <span>Switch between related views.</span>
            </div>
        </div>

        <p class="intro">
            Tabs organize related content into separate views that share the same
            context.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Account settings</legend>
                <p class="field-hint">Selecting a tab swaps the panel below.</p>
                <Tabs>
                    @foreach (var tab in tabs)
                    {
                        <Button @onclick="() => activeTab = tab">@tab</Button>
                    }
                </Tabs>
                <div style="padding-top:0.75rem;">
                    @switch (activeTab)
                    {
                        case "Profile":
                            <p style="margin:0;">Update your name, photo, and bio.</p>
                            break;
                        case "Security":
                            <p style="margin:0;">Manage your password and two-factor authentication.</p>
                            break;
                        default:
                            <p style="margin:0;">Manage connected apps and API tokens.</p>
                            break;
                    }
                </div>
            </fieldset>

        </div>
    </div>
</div>

@code {
    private static readonly string[] tabs = ["Profile", "Security", "Integrations"];
    private string activeTab = tabs[0];
}
