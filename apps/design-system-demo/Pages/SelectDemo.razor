@page "/select"
@rendermode InteractiveServer

<PageTitle>Select · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Select">
        PBSelect is a form control for selecting a value from a set of options, like
        Angular Material's <code>mat-select</code>: a trigger inside an M3 form field that
        opens a listbox panel.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Bind the selection with <code>@@bind-Value</code>. The selected option is highlighted and marked with a checkmark.</p>

        <ExampleCard Title="Basic select" RazorCode="@(
@"<PBSelect TValue=""string"" Label=""Favorite food"" @bind-Value=""food"">
    @foreach (var option in foods)
    {
        <PBOption Value=""@option"">@option</PBOption>
    }
</PBSelect>
<p>Selected: @food</p>")">
            <PBSelect TValue="string" Label="Favorite food" @bind-Value="food">
                @foreach (var option in foods)
                {
                    <PBOption Value="@option">@option</PBOption>
                }
            </PBSelect>
            <p class="status">Selected: @(food ?? "—")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">The <code>Outline</code> appearance, a placeholder, supporting text, a disabled option and an error state.</p>

        <ExampleCard Title="Appearance, disabled option and error" RazorCode="@(
@"<PBSelect TValue=""string"" Appearance=""PBFormFieldAppearance.Outline"" Label=""Car""
          Placeholder=""Pick one"" SupportingText=""Saab is unavailable"" @bind-Value=""car"">
    <PBOption Value=""@(""volvo"")"">Volvo</PBOption>
    <PBOption Value=""@(""saab"")"" Disabled>Saab</PBOption>
    <PBOption Value=""@(""mercedes"")"">Mercedes</PBOption>
</PBSelect>
<PBSelect TValue=""string"" Label=""Required"" ErrorText=""You must make a selection"" Required>
    ...
</PBSelect>")">
            <div class="demo-row">
                <PBSelect TValue="string" Appearance="PBFormFieldAppearance.Outline" Label="Car" Placeholder="Pick one"
                          SupportingText="Saab is unavailable" @bind-Value="car">
                    <PBOption Value="@("volvo")">Volvo</PBOption>
                    <PBOption Value="@("saab")" Disabled>Saab</PBOption>
                    <PBOption Value="@("mercedes")">Mercedes</PBOption>
                    <PBOption Value="@("audi")">Audi</PBOption>
                </PBSelect>
                <PBSelect TValue="string" Label="Required" ErrorText="@(required is null ? "You must make a selection" : null)" Required @bind-Value="required">
                    <PBOption Value="@("a")">Option A</PBOption>
                    <PBOption Value="@("b")">Option B</PBOption>
                </PBSelect>
                <PBSelect TValue="string" Label="Disabled" Disabled Value="@("one")">
                    <PBOption Value="@("one")">Option one</PBOption>
                </PBSelect>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Value</code></td><td><code>TValue?</code></td><td>The selected value. Supports <code>@@bind-Value</code>.</td></tr>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Floating label (mat-label).</td></tr>
                <tr><td><code>Placeholder</code></td><td><code>string?</code></td><td>Shown when nothing is selected, once the label has floated.</td></tr>
                <tr><td><code>Appearance</code></td><td><code>PBFormFieldAppearance</code></td><td><code>Fill</code> (default) or <code>Outline</code>.</td></tr>
                <tr><td><code>SupportingText</code> / <code>ErrorText</code></td><td><code>string?</code></td><td>mat-hint / mat-error under the field. An error colors the field.</td></tr>
                <tr><td><code>Disabled</code>, <code>Required</code></td><td><code>bool</code></td><td>Disables the control / marks the label with an asterisk.</td></tr>
                <tr><td><code>HideSingleSelectionIndicator</code></td><td><code>bool</code></td><td>Hides the checkmark on the selected option.</td></tr>
                <tr><td><code>Prefix</code> / <code>Suffix</code></td><td><code>RenderFragment?</code></td><td>Leading / trailing icons.</td></tr>
                <tr><td><code>PBOption.Value</code>, <code>.Disabled</code></td><td><code>TValue</code>, <code>bool</code></td><td>An option (mat-option); its content is shown in the trigger when selected.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The trigger is a <code>combobox</code> that controls a <code>listbox</code> panel;
            the active option is announced through <code>aria-activedescendant</code>, so focus
            stays on the trigger. Keyboard: Arrow keys change the value while closed; Enter,
            Space or Alt+Down open; arrows, Home and End move; Enter/Space select; Escape or
            Tab close; typing jumps to a matching option.
        </div>
    </section>
</div>

@code {
    private static readonly string[] foods = ["Steak", "Pizza", "Tacos"];
    private string? food;
    private string? car;
    private string? required;
}
