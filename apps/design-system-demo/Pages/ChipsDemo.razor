@page "/chips"
@rendermode InteractiveServer

<PageTitle>Chips · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Chips">
        Chips represent a small piece of information, such as a filter or a tag,
        in a compact, interactive form.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Filter chips toggle a selection on and off; selected chips fill with the tonal secondary color and show a checkmark.</p>

        <ExampleCard Title="Filter chips" RazorCode="@(
@"<PBChips>
    @foreach (var tag in tags)
    {
        <span role=""listitem"" class=""@ChipClass(tag)"" @onclick=""() => Toggle(tag)"">
            @ChipLabel(tag)
        </span>
    }
</PBChips>")">
            <PBChips>
                @foreach (var tag in tags)
                {
                    <span role="listitem" class="@ChipClass(tag)" @onclick="() => Toggle(tag)">
                        @ChipLabel(tag)
                    </span>
                }
            </PBChips>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Input chips represent something the user has already entered or selected, with a trailing action to remove it.</p>

        <ExampleCard Title="Input chips" RazorCode="@(
@"<PBChips>
    @foreach (var member in members)
    {
        <span role=""listitem"" class=""workspace-chip--input"">
            @member
            <button type=""button"" class=""workspace-chip__remove"" aria-label=""Remove @member"" @onclick=""() => members.Remove(member)"">×</button>
        </span>
    }
</PBChips>")">
            <PBChips>
                @foreach (var member in members)
                {
                    <span role="listitem" class="workspace-chip--input">
                        @member
                        <button type="button" class="workspace-chip__remove" aria-label="Remove @member" @onclick="() => members.Remove(member)">×</button>
                    </span>
                }
            </PBChips>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Assist chips surface a suggested action, typically with a leading icon.</p>

        <ExampleCard Title="Assist chips" RazorCode="@(
@"<PBChips>
    <span role=""listitem"" class=""workspace-chip--assist"">📅 Add to calendar</span>
    <span role=""listitem"" class=""workspace-chip--assist"">📍 View on map</span>
</PBChips>")">
            <PBChips>
                <span role="listitem" class="workspace-chip--assist">📅 Add to calendar</span>
                <span role="listitem" class="workspace-chip--assist">📍 View on map</span>
            </PBChips>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The chip items, typically <code>role="listitem"</code> elements.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;div role="list"&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The container uses <code>role="list"</code>; give each chip
            <code>role="listitem"</code> as shown above so the set is announced as a
            list of items.
        </div>
    </section>
</div>

@code {
    private static readonly string[] tags = ["Design", "Frontend", "Accessibility", "Blazor"];
    private readonly HashSet<string> selected = ["Frontend"];
    private readonly List<string> members = ["Ali", "Sara", "Kian"];

    private string ChipClass(string tag) => selected.Contains(tag) ? "workspace-chip--selected" : "";
    private string ChipLabel(string tag) => selected.Contains(tag) ? $"✓ {tag}" : tag;

    private void Toggle(string tag)
    {
        if (!selected.Remove(tag))
        {
            selected.Add(tag);
        }
    }
}
