@page "/datepicker"
@rendermode InteractiveServer

<PageTitle>Datepicker · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Datepicker">
        The datepicker lets users enter or pick a calendar date using the
        browser's native date input.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Selecting a date updates the status below.</p>

        <ExampleCard Title="Default" RazorCode="@(
@"<PBDatepicker Label=""Start date""
    value=""@selectedDate""
    @onchange=""@((ChangeEventArgs e) => selectedDate = e.Value?.ToString())"" />")">
            <PBDatepicker Label="Start date" value="@selectedDate" @onchange="@((ChangeEventArgs e) => selectedDate = e.Value?.ToString())" />
            <p class="status">Selected: @(selectedDate ?? "—")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled datepicker cannot be changed.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBDatepicker Label=""Locked date"" disabled />")">
            <PBDatepicker Label="Locked date" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered above the date field.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="date"&gt;</code>.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Uses the browser's native date input, so keyboard entry, screen reader
            support, and locale formatting come from the platform.
        </div>
    </section>
</div>

@code {
    private string? selectedDate;
}
