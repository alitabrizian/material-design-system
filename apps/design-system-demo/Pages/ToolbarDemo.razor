@page "/toolbar"
@rendermode InteractiveServer

<PageTitle>Toolbar · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Toolbar">
        A toolbar groups navigation and actions into a single horizontal bar,
        typically at the top of a page or panel.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Actions are laid out left to right.</p>

        <ExampleCard Title="Document toolbar" RazorCode="@(
@"<PBToolbar>
    <strong>Untitled document</strong>
    <PBButton>Share</PBButton>
    <PBButton>Save</PBButton>
</PBToolbar>")">
            <PBToolbar style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                <strong>Untitled document</strong>
                <span style="display:inline-flex; gap:0.5rem;">
                    <PBButton>Share</PBButton>
                    <PBButton>Save</PBButton>
                </span>
            </PBToolbar>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The toolbar's content.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;header&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a <code>&lt;header&gt;</code> landmark; give it an
            <code>aria-label</code> via <code>AdditionalAttributes</code> when a page
            has more than one toolbar.
        </div>
    </section>
</div>
