@page "/toolbar"
@rendermode InteractiveServer

<PageTitle>Toolbar · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Toolbar</h2>
            </div>
            <div>
                <span>Group navigation and actions in a bar.</span>
            </div>
        </div>

        <p class="intro">
            A toolbar groups navigation and actions into a single horizontal bar,
            typically at the top of a page or panel.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Document toolbar</legend>
                <p class="field-hint">Actions are laid out left to right.</p>
                <Toolbar style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                    <strong>Untitled document</strong>
                    <span style="display:inline-flex; gap:0.5rem;">
                        <Button>Share</Button>
                        <Button>Save</Button>
                    </span>
                </Toolbar>
            </fieldset>

        </div>
    </div>
</div>
