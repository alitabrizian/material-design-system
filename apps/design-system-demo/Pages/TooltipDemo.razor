@page "/tooltip"
@rendermode InteractiveServer

<PageTitle>Tooltip · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Tooltip</h1>
        <p class="intro">A tooltip shows a short explanation when the user hovers or focuses an element.</p>
    </header>

    <section class="doc-section">
        <h2>Icon button</h2>
        <p class="field-hint">Hover the button to reveal the tooltip text.</p>

        <div class="doc-example">
            <PBTooltip Label="Copy to clipboard">
                <PBButton>⧉</PBButton>
            </PBTooltip>
        </div>

        <CodeSnippet Code="@(
@"<PBTooltip Label=""Copy to clipboard"">
    <PBButton>⧉</PBButton>
</PBTooltip>")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Rendered as the native <code>title</code> attribute.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The element the tooltip is attached to.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Uses the native <code>title</code> attribute, which most screen readers
            announce but which isn't keyboard-discoverable on its own; the wrapped
            control's own focusability (e.g. a real <code>&lt;button&gt;</code>) is
            what makes the tooltip reachable.
        </div>
    </section>
</div>
