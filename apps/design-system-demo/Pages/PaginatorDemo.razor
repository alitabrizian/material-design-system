@page "/paginator"
@rendermode InteractiveServer

<PageTitle>Paginator · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Paginator</h2>
            </div>
            <div>
                <span>Move through a set of results.</span>
            </div>
        </div>

        <p class="intro">
            A paginator lets the user move between pages of a larger result set.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Result pages</legend>
                <p class="field-hint">Clicking a page updates the status below.</p>
                <Paginator>
                    <Button disabled="@(currentPage == 1)" @onclick="() => currentPage--">← Prev</Button>
                    <span>Page @currentPage of @totalPages</span>
                    <Button disabled="@(currentPage == totalPages)" @onclick="() => currentPage++">Next →</Button>
                </Paginator>
            </fieldset>

        </div>
    </div>
</div>

@code {
    private int currentPage = 1;
    private const int totalPages = 5;
}
