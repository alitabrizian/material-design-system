@page "/paginator"
@rendermode InteractiveServer

<PageTitle>Paginator · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Paginator">
        PBPaginator provides navigation for paged information, like Angular Material's
        <code>mat-paginator</code>: a page-size select, a range label and first/previous/next/last
        buttons.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Bind <code>PageIndex</code> and <code>PageSize</code>, or handle <code>Page</code>.</p>

        <ExampleCard Title="Configurable paginator" RazorCode="@(
@"<PBPaginator Length=""100"" @bind-PageIndex=""pageIndex"" @bind-PageSize=""pageSize""
             PageSizeOptions=""@(new[] { 5, 10, 25, 100 })"" ShowFirstLastButtons
             Page=""e => lastEvent = e"" />")">
            <PBPaginator Length="100" @bind-PageIndex="pageIndex" @bind-PageSize="pageSize"
                         PageSizeOptions="@(new[] { 5, 10, 25, 100 })" ShowFirstLastButtons Page="e => lastEvent = e" />
            <p class="status">Page index: @pageIndex · Page size: @pageSize @(lastEvent is null ? "" : $"· Last event: {lastEvent}")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Without the page-size select, and disabled.</p>

        <ExampleCard Title="Minimal and disabled" RazorCode="@(
@"<PBPaginator Length=""50"" PageSize=""10"" HidePageSize />
<PBPaginator Length=""50"" PageSize=""10"" Disabled />")">
            <PBPaginator Length="50" PageSize="10" HidePageSize />
            <PBPaginator Length="50" PageSize="10" Disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Length</code></td><td><code>int</code></td><td>Total number of items.</td></tr>
                <tr><td><code>PageIndex</code>, <code>PageSize</code></td><td><code>int</code></td><td>Current page (0-based) and size. Both support <code>@@bind-</code>.</td></tr>
                <tr><td><code>PageSizeOptions</code></td><td><code>IReadOnlyList&lt;int&gt;</code></td><td>Choices in the "Items per page" select.</td></tr>
                <tr><td><code>ShowFirstLastButtons</code>, <code>HidePageSize</code>, <code>Disabled</code></td><td><code>bool</code></td><td>Extra buttons / hide the select / disable everything.</td></tr>
                <tr><td><code>Page</code></td><td><code>EventCallback&lt;PBPageEvent&gt;</code></td><td>Raised on every page or page-size change (MatPaginator's PageEvent).</td></tr>
                <tr><td><code>ItemsPerPageLabel</code>, <code>…PageLabel</code></td><td><code>string</code></td><td>Localizable labels (MatPaginatorIntl).</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The paginator is a labelled <code>group</code>; each icon button has an accessible name
            ("Next page", …) and a tooltip-style title; the range label is a polite live region.
        </div>
    </section>
</div>

@code {
    private int pageIndex;
    private int pageSize = 10;
    private PBPageEvent? lastEvent;
}
