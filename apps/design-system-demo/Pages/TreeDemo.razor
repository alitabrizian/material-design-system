@page "/tree"
@rendermode InteractiveServer

<PageTitle>Tree · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Tree</h1>
        <p class="intro">
            A tree displays hierarchical data, such as a file system or an
            organization chart.
        </p>
    </header>

    <section class="doc-section">
        <h2>File explorer</h2>
        <p class="field-hint">Nested lists represent parent-child relationships.</p>

        <div class="doc-example">
            <PBTree>
                <li role="treeitem">
                    libs
                    <ul role="group">
                        <li role="treeitem">design-system</li>
                    </ul>
                </li>
                <li role="treeitem">
                    apps
                    <ul role="group">
                        <li role="treeitem">design-system-demo</li>
                    </ul>
                </li>
            </PBTree>
        </div>

        <CodeSnippet Code="@(
@"<PBTree>
    <li role=""treeitem"">
        libs
        <ul role=""group"">
            <li role=""treeitem"">design-system</li>
        </ul>
    </li>
</PBTree>")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The tree's <code>role="treeitem"</code> nodes.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;ul role="tree"&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The root has <code>role="tree"</code>; give each item
            <code>role="treeitem"</code> and each nested list
            <code>role="group"</code> as shown, so assistive technology can navigate
            the hierarchy.
        </div>
    </section>
</div>
