@page "/radio-button"
@rendermode InteractiveServer

<PageTitle>Radio Button · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Radio Button</h1>
        <p class="intro">
            Radio buttons let the user choose exactly one option from a mutually
            exclusive set.
        </p>
    </header>

    <section class="doc-section">
        <h2>Delivery speed</h2>
        <p class="field-hint">Only one option can be selected at a time.</p>

        <div class="doc-example">
            @foreach (var option in speedOptions)
            {
                <PBRadioButton Label="@option" name="delivery-speed" checked="@(selectedSpeed == option)" @onchange='() => selectedSpeed = option' />
            }
            <span class="status">Selected: @selectedSpeed</span>
        </div>

        <CodeSnippet Code="@(
@"@foreach (var option in speedOptions)
{
    <PBRadioButton Label=""@option""
        name=""delivery-speed""
        checked=""@(selectedSpeed == option)""
        @onchange=""() => selectedSpeed = option"" />
}")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered next to the radio.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="radio"&gt;</code>, including <code>name</code>, <code>checked</code> and <code>@@onchange</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Give every radio in a group the same <code>name</code> attribute so
            assistive technology announces them as one mutually exclusive set.
        </div>
    </section>
</div>

@code {
    private static readonly string[] speedOptions = ["Standard", "Express", "Overnight"];
    private string selectedSpeed = speedOptions[0];
}
