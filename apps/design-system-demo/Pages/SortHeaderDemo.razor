@page "/sort-header"
@rendermode InteractiveServer

<PageTitle>Sort Header · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Sort Header">
        PBSortHeader adds sorting state and display to tabular data:
        clicking cycles ascending → descending → unsorted, and the
        arrow previews on hover.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Each header binds its own direction; the page keeps a single active sort.</p>

        <ExampleCard Title="Sorting overview" RazorCode="@(
@"<th aria-sort=""..."">
    <PBSortHeader Label=""Dessert"" Direction=""@Dir(""name"")""
                  DirectionChanged=""@(d => Sort(""name"", d))"" />
</th>")">
            <PBTable Label="Desserts">
                <thead>
                    <tr>
                        <th><PBSortHeader Label="Dessert (100g)" Direction="@Dir("name")" DirectionChanged="@(d => Sort("name", d))" /></th>
                        <th><PBSortHeader Label="Calories" Direction="@Dir("calories")" DirectionChanged="@(d => Sort("calories", d))" /></th>
                        <th><PBSortHeader Label="Fat (g)" Direction="@Dir("fat")" DirectionChanged="@(d => Sort("fat", d))" /></th>
                        <th><PBSortHeader Label="Carbs (g)" Direction="@Dir("carbs")" DirectionChanged="@(d => Sort("carbs", d))" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Sorted)
                    {
                        <tr><td>@d.Name</td><td>@d.Calories</td><td>@d.Fat</td><td>@d.Carbs</td></tr>
                    }
                </tbody>
            </PBTable>
            <p class="status">Sorted by: @(active == "" || direction == PBSortDirection.None ? "—" : $"{active} ({direction})")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>The column header text.</td></tr>
                <tr><td><code>Direction</code></td><td><code>PBSortDirection</code></td><td><code>None</code>, <code>Ascending</code> or <code>Descending</code>. Supports <code>@@bind-Direction</code>.</td></tr>
                <tr><td><code>ArrowPosition</code></td><td><code>PBSortArrowPosition</code></td><td><code>After</code> (default) or <code>Before</code> the label.</td></tr>
                <tr><td><code>DisableClear</code></td><td><code>bool</code></td><td>Skips the unsorted state when cycling.</td></tr>
                <tr><td><code>Disabled</code></td><td><code>bool</code></td><td>Disables sorting on this column.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The header is a button whose label announces the current sort ("Calories, sorted
            ascending. Change sorting"). Set <code>aria-sort</code> on the enclosing
            <code>&lt;th&gt;</code> as well.
        </div>
    </section>
</div>

@code {
    private sealed record Dessert(string Name, int Calories, int Fat, int Carbs);

    private static readonly Dessert[] desserts =
    [
        new("Frozen yogurt", 159, 6, 24),
        new("Ice cream sandwich", 237, 9, 37),
        new("Eclair", 262, 16, 24),
        new("Cupcake", 305, 4, 67),
        new("Gingerbread", 356, 16, 49),
    ];

    private string active = "";
    private PBSortDirection direction;

    private PBSortDirection Dir(string column) => column == active ? direction : PBSortDirection.None;

    private void Sort(string column, PBSortDirection value)
    {
        active = column;
        direction = value;
    }

    private IEnumerable<Dessert> Sorted
    {
        get
        {
            Func<Dessert, object> key = active switch
            {
                "calories" => d => d.Calories,
                "fat" => d => d.Fat,
                "carbs" => d => d.Carbs,
                _ => d => d.Name,
            };
            return direction switch
            {
                PBSortDirection.Ascending => desserts.OrderBy(key),
                PBSortDirection.Descending => desserts.OrderByDescending(key),
                _ => desserts,
            };
        }
    }
}
