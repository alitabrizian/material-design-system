@page "/sort-header"
@rendermode InteractiveServer

<PageTitle>Sort Header · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Sort Header">A sort header lets the user toggle the sort direction of a table column.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Click the header to toggle the sort direction.</p>

        <ExampleCard Title="Table column" RazorCode="@(@"<PBSortHeader Label=""Name"" @onclick=""ToggleSort"" />")">
            <PBSortHeader Label="Name" @onclick="ToggleSort" />
            <span class="status">Sort: @sortDirection</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>The column name; also used to build <code>aria-label="Sort {Label}"</code>.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>Optional content (e.g. a sort icon) rendered before the label.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;button&gt;</code>, including <code>@@onclick</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native <code>&lt;button&gt;</code> labeled "Sort {column}".
            The current sort direction is only reflected in on-screen text in this
            demo — expose it via <code>aria-sort</code> on the owning table header
            cell in real usage.
        </div>
    </section>
</div>

@code {
    private string sortDirection = "ascending";

    private void ToggleSort() =>
        sortDirection = sortDirection == "ascending" ? "descending" : "ascending";
}
