@page "/stepper"
@rendermode InteractiveServer

<PageTitle>Stepper · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Stepper">A stepper breaks a task into an ordered sequence of steps.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Advance through the steps with the buttons below.</p>

        <ExampleCard Title="Checkout" RazorCode="@(
@"<PBStepper>
    @foreach (var step in steps)
    {
        <li>@step</li>
    }
</PBStepper>")">
            <PBStepper>
                @for (var i = 0; i < steps.Length; i++)
                {
                    var index = i;
                    <li style="font-weight:@(index == currentStep ? 700 : 400);">@steps[index]</li>
                }
            </PBStepper>
            <div class="actions">
                <PBButton disabled="@(currentStep == 0)" @onclick="() => currentStep--">Back</PBButton>
                <PBButton disabled="@(currentStep == steps.Length - 1)" @onclick="() => currentStep++">Next</PBButton>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The step items, typically <code>&lt;li&gt;</code> elements.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;ol&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native ordered list (<code>&lt;ol&gt;</code>), giving step
            numbers for free. The current-step styling above is visual only; expose
            it with <code>aria-current="step"</code> in real usage.
        </div>
    </section>
</div>

@code {
    private static readonly string[] steps = ["Cart", "Shipping", "Payment", "Review"];
    private int currentStep;
}
