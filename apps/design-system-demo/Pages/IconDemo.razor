@page "/icon"
@rendermode InteractiveServer

<PageTitle>Icon · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Icon">
        Icons are compact, glyph-based representations of an action, object, or
        state.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Each icon carries an accessible label.</p>

        <ExampleCard Title="Standalone icons" RazorCode="@(@"<PBIcon Label=""Search"">⌕</PBIcon>")">
            <span style="display:inline-flex; gap:1rem; font-size:1.4rem;">
                <PBIcon Label="Search">⌕</PBIcon>
                <PBIcon Label="Settings">⚙</PBIcon>
                <PBIcon Label="Favorite">★</PBIcon>
            </span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Icons commonly appear alongside text in a button.</p>

        <ExampleCard Title="Icon with a button" RazorCode="@(
@"<PBButton>
    <PBIcon Label="""">→</PBIcon>
    Continue
</PBButton>")">
            <PBButton>
                <PBIcon Label="">→</PBIcon>
                Continue
            </PBButton>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Rendered as <code>aria-label</code> on the icon.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The icon glyph.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The icon has <code>role="img"</code> with an <code>aria-label</code> from
            <code>Label</code>. When an icon is purely decorative (as in the button
            example), pass an empty <code>Label</code> so it isn't announced twice.
        </div>
    </section>
</div>
