@page "/list"
@rendermode InteractiveServer

<PageTitle>List · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="List">
        A list presents a vertical collection of related items, such as
        navigation entries or search results.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">A simple list of text items.</p>

        <ExampleCard Title="Recent activity" RazorCode="@(
@"<PBList>
    @foreach (var entry in activity)
    {
        <li>@entry</li>
    }
</PBList>")">
            <PBList>
                @foreach (var entry in activity)
                {
                    <li>@entry</li>
                }
            </PBList>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A two-line item with a leading icon and trailing meta text.</p>

        <ExampleCard Title="Two-line with icon" RazorCode="@(
@"<PBList>
    @foreach (var msg in messages)
    {
        <li class=""workspace-list-item"">
            <span class=""workspace-list-item__icon"">@msg.Icon</span>
            <span class=""workspace-list-item__content"">
                <span class=""workspace-list-item__title"">@msg.Title</span>
                <span class=""workspace-list-item__subtitle"">@msg.Subtitle</span>
            </span>
            <span class=""workspace-list-item__trailing"">@msg.Time</span>
        </li>
    }
</PBList>")">
            <PBList>
                @foreach (var msg in messages)
                {
                    <li class="workspace-list-item">
                        <span class="workspace-list-item__icon">@msg.Icon</span>
                        <span class="workspace-list-item__content">
                            <span class="workspace-list-item__title">@msg.Title</span>
                            <span class="workspace-list-item__subtitle">@msg.Subtitle</span>
                        </span>
                        <span class="workspace-list-item__trailing">@msg.Time</span>
                    </li>
                }
            </PBList>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The list items, typically <code>&lt;li&gt;</code> elements.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;ul&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native <code>&lt;ul&gt;</code>, so use <code>&lt;li&gt;</code>
            children to keep the list semantics assistive technology relies on.
        </div>
    </section>
</div>

@code {
    private static readonly string[] activity =
    [
        "Ali updated the PBAutoComplete component",
        "New demo page published for PBBadge",
        "Design tokens synced from Figma",
    ];

    private sealed record Message(string Icon, string Title, string Subtitle, string Time);

    private static readonly Message[] messages =
    [
        new("👤", "Sara Ahmadi", "Can you review the PR when you get a chance?", "9:41"),
        new("📎", "Kian Rostami", "Attached the updated token spreadsheet.", "Yesterday"),
    ];
}
