@page "/table"
@rendermode InteractiveServer

<PageTitle>Table · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Table">A table displays a structured collection of data across rows and columns.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Rows are supplied as child content.</p>

        <ExampleCard Title="Team members" RazorCode="@(
@"<PBTable>
    @foreach (var member in members)
    {
        <tr>
            <td>@member.Name</td>
            <td>@member.Role</td>
        </tr>
    }
</PBTable>")">
            <PBTable>
                @foreach (var member in members)
                {
                    <tr>
                        <td>@member.Name</td>
                        <td>@member.Role</td>
                    </tr>
                }
            </PBTable>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The table's <code>&lt;tr&gt;</code> rows.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;table&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>PBTable</code> wraps rows directly in <code>&lt;tbody&gt;</code>
            with no header row markup yet; add a <code>&lt;thead&gt;</code> with
            <code>&lt;th scope="col"&gt;</code> cells in real usage so column
            headers are announced.
        </div>
    </section>
</div>

@code {
    private static readonly (string Name, string Role)[] members =
    [
        ("Ali Tabrizian", "Frontend Engineer"),
        ("Jordan Lee", "Product Designer"),
        ("Priya Nair", "Backend Engineer"),
    ];
}
