@page "/table"
@rendermode InteractiveServer

<PageTitle>Table · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Table">
        PBTable displays rows of data with Angular Material's <code>mat-table</code> styling:
        56px header row, 52px data rows, M3 typography and outline row dividers.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Pass a native <code>&lt;thead&gt;</code> and <code>&lt;tbody&gt;</code>. Numeric columns use <code>pb-table__cell--numeric</code>.</p>

        <ExampleCard Title="Basic table" RazorCode="@(
@"<PBTable Label=""Periodic elements"">
    <thead>
        <tr><th>No.</th><th>Name</th><th class=""pb-table__cell--numeric"">Weight</th><th>Symbol</th></tr>
    </thead>
    <tbody>
        @foreach (var e in elements)
        {
            <tr><td>@e.Position</td><td>@e.Name</td>
                <td class=""pb-table__cell--numeric"">@e.Weight</td><td>@e.Symbol</td></tr>
        }
    </tbody>
</PBTable>")">
            <PBTable Label="Periodic elements">
                <thead>
                    <tr><th>No.</th><th>Name</th><th class="pb-table__cell--numeric">Weight</th><th>Symbol</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in PeriodicElements.All.Take(5))
                    {
                        <tr><td>@e.Position</td><td>@e.Name</td><td class="pb-table__cell--numeric">@e.Weight</td><td>@e.Symbol</td></tr>
                    }
                </tbody>
            </PBTable>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A table combined with <code>PBSortHeader</code> and <code>PBPaginator</code>, like mat-table with matSort and mat-paginator.</p>

        <ExampleCard Title="Sorting and pagination" RazorCode="@(
@"<PBTable>
    <thead><tr>
        <th aria-sort=""@AriaSort(""name"")"">
            <PBSortHeader Label=""Name"" Direction=""@Dir(""name"")"" DirectionChanged=""@(d => Sort(""name"", d))"" />
        </th>
        ...
    </tr></thead>
    <tbody>@foreach (var e in Page) { ... }</tbody>
</PBTable>
<PBPaginator Length=""@elements.Count"" @bind-PageIndex=""pageIndex"" @bind-PageSize=""pageSize"" ShowFirstLastButtons />")">
            <PBTable Label="Sortable periodic elements">
                <thead>
                    <tr>
                        <th aria-sort="@AriaSort("position")"><PBSortHeader Label="No." Direction="@Dir("position")" DirectionChanged="@(d => Sort("position", d))" /></th>
                        <th aria-sort="@AriaSort("name")"><PBSortHeader Label="Name" Direction="@Dir("name")" DirectionChanged="@(d => Sort("name", d))" /></th>
                        <th aria-sort="@AriaSort("weight")" class="pb-table__cell--numeric"><PBSortHeader Label="Weight" ArrowPosition="PBSortArrowPosition.Before" Direction="@Dir("weight")" DirectionChanged="@(d => Sort("weight", d))" style="margin-left:auto" /></th>
                        <th aria-sort="@AriaSort("symbol")"><PBSortHeader Label="Symbol" Direction="@Dir("symbol")" DirectionChanged="@(d => Sort("symbol", d))" /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in PageRows)
                    {
                        <tr><td>@e.Position</td><td>@e.Name</td><td class="pb-table__cell--numeric">@e.Weight</td><td>@e.Symbol</td></tr>
                    }
                </tbody>
            </PBTable>
            <PBPaginator Length="@PeriodicElements.All.Count" @bind-PageIndex="pageIndex" @bind-PageSize="pageSize"
                         PageSizeOptions="@(new[] { 5, 10, 20 })" ShowFirstLastButtons Label="Select page of periodic elements" />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>Native <code>thead</code>/<code>tbody</code>/<code>tfoot</code> (or bare rows).</td></tr>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Accessible name (<code>aria-label</code>) of the table.</td></tr>
                <tr><td><code>pb-table__cell--numeric</code></td><td>CSS class</td><td>End-aligns a cell or header.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            PBTable renders a native <code>&lt;table&gt;</code>, so rows, headers and cells keep their
            built-in semantics. Put <code>aria-sort</code> on sortable header cells. On narrow screens
            the table scrolls horizontally inside its container.
        </div>
    </section>
</div>

@code {
    private string sortColumn = "";
    private PBSortDirection sortDirection = PBSortDirection.None;
    private int pageIndex;
    private int pageSize = 5;

    private PBSortDirection Dir(string column) => column == sortColumn ? sortDirection : PBSortDirection.None;

    private string? AriaSort(string column) => Dir(column) switch
    {
        PBSortDirection.Ascending => "ascending",
        PBSortDirection.Descending => "descending",
        _ => null,
    };

    private void Sort(string column, PBSortDirection direction)
    {
        sortColumn = column;
        sortDirection = direction;
        pageIndex = 0;
    }

    private IEnumerable<PeriodicElement> Sorted
    {
        get
        {
            Func<PeriodicElement, object> key = sortColumn switch
            {
                "name" => e => e.Name,
                "weight" => e => e.Weight,
                "symbol" => e => e.Symbol,
                _ => e => e.Position,
            };
            return sortDirection switch
            {
                PBSortDirection.Ascending => PeriodicElements.All.OrderBy(key),
                PBSortDirection.Descending => PeriodicElements.All.OrderByDescending(key),
                _ => PeriodicElements.All,
            };
        }
    }

    private IEnumerable<PeriodicElement> PageRows => Sorted.Skip(pageIndex * pageSize).Take(pageSize);
}
