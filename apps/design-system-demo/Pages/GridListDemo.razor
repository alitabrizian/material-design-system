@page "/grid-list"
@rendermode InteractiveServer

<PageTitle>Grid List · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Grid List">
        A grid list arranges a collection of items into a uniform, structured
        grid.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Items are arranged edge to edge in a grid.</p>

        <ExampleCard Title="Photo grid" RazorCode="@(
@"<PBGridList style=""display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem;"">
    @foreach (var label in tiles)
    {
        <div>@label</div>
    }
</PBGridList>")">
            <PBGridList style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem;">
                @foreach (var label in tiles)
                {
                    <div style="aspect-ratio:1; display:grid; place-items:center; background:var(--catalog-soft); border-radius:0.4rem;">@label</div>
                }
            </PBGridList>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The grid's tiles.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;div&gt;</code>; used above to supply the grid layout via <code>style</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>PBGridList</code> does not currently apply <code>role="list"</code>/
            <code>role="listitem"</code> semantics. If the tiles represent a
            meaningful collection, add those roles via <code>AdditionalAttributes</code>.
        </div>
    </section>
</div>

@code {
    private static readonly string[] tiles = ["1", "2", "3", "4", "5", "6"];
}
