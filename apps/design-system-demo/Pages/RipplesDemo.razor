@page "/ripples"
@rendermode InteractiveServer

<PageTitle>Ripples · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Ripples">
        PBRipples connects user input to screen reactions with an ink ripple, like Angular
        Material's <code>matRipple</code>. Buttons, toggles, list items, tabs and chips already
        have one built in.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Click (or press Enter/Space when focused) anywhere in the area. The ink starts at the pointer, fills the area over 450ms and fades over 400ms on release.</p>

        <ExampleCard Title="Ripple overview" RazorCode="@(
@"<PBRipples Centered=""@centered"" Unbounded=""@unbounded"" Disabled=""@disabled""
           Color=""var(--md-sys-color-primary)"" class=""ripple-container"">
    Click me
</PBRipples>")">
            <div class="demo-row" style="margin-bottom:16px">
                <PBCheckbox Label="Centered" checked="@centered" @onchange="e => centered = (bool)e.Value!" />
                <PBCheckbox Label="Unbounded" checked="@unbounded" @onchange="e => unbounded = (bool)e.Value!" />
                <PBCheckbox Label="Disabled" checked="@disabled" @onchange="e => disabled = (bool)e.Value!" />
                <PBCheckbox Label="Primary color" checked="@primary" @onchange="e => primary = (bool)e.Value!" />
            </div>
            <PBRipples Centered="centered" Unbounded="unbounded" Disabled="disabled"
                       Color="@(primary ? "var(--md-sys-color-primary)" : null)" class="ripple-container" tabindex="0">
                Click me
            </PBRipples>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Centered</code></td><td><code>bool</code></td><td>Always starts from the center (matRippleCentered).</td></tr>
                <tr><td><code>Unbounded</code></td><td><code>bool</code></td><td>Ink may extend past the container (matRippleUnbounded).</td></tr>
                <tr><td><code>Disabled</code></td><td><code>bool</code></td><td>No ripples (matRippleDisabled).</td></tr>
                <tr><td><code>Color</code></td><td><code>string?</code></td><td>Ink color as a token expression; defaults to the text color.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Ripples are purely visual and are skipped entirely when the user prefers reduced motion.
        </div>
    </section>
</div>

@code {
    private bool centered;
    private bool unbounded;
    private bool disabled;
    private bool primary;
}
