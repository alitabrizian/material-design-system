@page "/progress-bar"
@rendermode InteractiveServer

<PageTitle>Progress Bar · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Progress Bar</h1>
        <p class="intro">A progress bar communicates the completion of a determinate operation.</p>
    </header>

    <section class="doc-section">
        <h2>Determinate</h2>
        <p class="field-hint">Use the buttons to advance the progress value.</p>

        <div class="doc-example">
            <PBProgressBar value="@progress" max="100" />
            <span class="status">@progress%</span>
            <div class="actions">
                <PBButton @onclick="() => progress = Math.Max(0, progress - 10)">-10%</PBButton>
                <PBButton @onclick="() => progress = Math.Min(100, progress + 10)">+10%</PBButton>
            </div>
        </div>

        <CodeSnippet Code="@(@"<PBProgressBar value=""@progress"" max=""100"" />")" />
    </section>

    <section class="doc-section">
        <h2>Indeterminate</h2>
        <p class="field-hint">Omitting a value shows an indeterminate track.</p>

        <div class="doc-example">
            <PBProgressBar />
        </div>

        <CodeSnippet Code="@(@"<PBProgressBar />")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;progress&gt;</code>, including <code>value</code> and <code>max</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native <code>&lt;progress&gt;</code> element, which exposes its
            value to assistive technology automatically.
        </div>
    </section>
</div>

@code {
    private int progress = 40;
}
