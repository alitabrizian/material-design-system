@page "/core"
@rendermode InteractiveServer

<PageTitle>Core · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Core</h1>
        <p class="intro">
            Core is a lightweight section wrapper used to apply the design system's
            foundational styles and behavior to a region of a page.
        </p>
    </header>

    <section class="doc-section">
        <h2>Section wrapper</h2>
        <p class="field-hint">Wraps arbitrary content in the shared foundation styles.</p>

        <div class="doc-example">
            <PBCore>
                <p style="margin:0;">Content rendered inside a PBCore section.</p>
            </PBCore>
        </div>

        <CodeSnippet Code="@(
@"<PBCore>
    <p>Content rendered inside a PBCore section.</p>
</PBCore>")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The wrapped content.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;section&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            <code>PBCore</code> renders a plain <code>&lt;section&gt;</code> with no
            implicit semantics; give it a heading or <code>aria-label</code> when it
            represents a distinct region of the page.
        </div>
    </section>
</div>
