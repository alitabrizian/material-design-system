@page "/core"
@rendermode InteractiveServer

<PageTitle>Core · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Core">
        The core layer is what every component builds on: the design tokens generated from Angular
        Material's prebuilt themes, and PBCore, which applies the M3 typography hierarchy
        (like <code>mat.core</code> and <code>.mat-typography</code>) to a region of content.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Headings and body text inside <code>PBCore</code> use the M3 type scale.</p>

        <ExampleCard Title="Typography" RazorCode="@(
@"<PBCore>
    <h1>Headline large</h1>
    <h2>Headline medium</h2>
    <h3>Headline small</h3>
    <h4>Title large</h4>
    <p>Body medium paragraph text.</p>
</PBCore>")">
            <PBCore>
                <h1>Headline large</h1>
                <h2>Headline medium</h2>
                <h3>Headline small</h3>
                <h4>Title large</h4>
                <h5>Title medium</h5>
                <h6>Title small</h6>
                <p>Body medium paragraph text, the default for content inside a PBCore region.</p>
                <small>Body small supporting text.</small>
            </PBCore>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">The color roles of the active theme. Switch themes with the palette button in the top bar.</p>

        <ExampleCard Title="Color roles" RazorCode="@(
@"<div style=""background: var(--md-sys-color-primary);
            color: var(--md-sys-color-on-primary)"">primary</div>")">
            <div class="token-grid">
                @foreach (var (role, on) in roles)
                {
                    <div class="token-swatch" style="background:var(--md-sys-color-@role);color:var(--md-sys-color-@on)">
                        <span>@role</span>
                    </div>
                }
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Every "on-" role is designed for contrast against its container role in all four themes;
            pair them as shown rather than mixing roles.
        </div>
    </section>
</div>

@code {
    private static readonly (string Role, string On)[] roles =
    [
        ("primary", "on-primary"), ("primary-container", "on-primary-container"),
        ("secondary", "on-secondary"), ("secondary-container", "on-secondary-container"),
        ("tertiary", "on-tertiary"), ("tertiary-container", "on-tertiary-container"),
        ("error", "on-error"), ("error-container", "on-error-container"),
        ("surface", "on-surface"), ("surface-container-low", "on-surface"),
        ("surface-container", "on-surface"), ("surface-container-highest", "on-surface"),
        ("surface-variant", "on-surface-variant"), ("inverse-surface", "inverse-on-surface"),
        ("outline", "surface"), ("outline-variant", "on-surface"),
    ];
}
