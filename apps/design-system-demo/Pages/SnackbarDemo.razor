@page "/snackbar"
@rendermode InteractiveServer

<PageTitle>Snackbar · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Snackbar</h1>
        <p class="intro">
            A snackbar shows a brief, unobtrusive message about the result of an
            action.
        </p>
    </header>

    <section class="doc-section">
        <h2>Save confirmation</h2>
        <p class="field-hint">Trigger the snackbar with the button below.</p>

        <div class="doc-example">
            <PBButton @onclick="() => isVisible = true">Save changes</PBButton>

            @if (isVisible)
            {
                <PBSnackbar>
                    Changes saved.
                    <PBButton @onclick="() => isVisible = false">Dismiss</PBButton>
                </PBSnackbar>
            }
        </div>

        <CodeSnippet Code="@(
@"<PBSnackbar>
    Changes saved.
    <PBButton @onclick=""Dismiss"">Dismiss</PBButton>
</PBSnackbar>")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The message and any inline actions.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;output role="status"&gt;</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders an <code>&lt;output role="status"&gt;</code>, which is announced
            politely by screen readers as it appears, without stealing focus.
        </div>
    </section>
</div>

@code {
    private bool isVisible;
}
