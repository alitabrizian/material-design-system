@page "/checkbox"
@rendermode InteractiveServer

<PageTitle>Checkbox · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Checkbox">
        Checkboxes let users select one or more items from a set of independent
        options.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Each checkbox toggles independently.</p>

        <ExampleCard Title="Preferences" RazorCode="@(
@"<PBCheckbox Label=""Email notifications""
    checked=""@emailEnabled""
    @onchange=""@((ChangeEventArgs e) => emailEnabled = (bool)e.Value!)"" />")">
            <PBCheckbox Label="Email notifications" checked="@emailEnabled" @onchange="@((ChangeEventArgs e) => emailEnabled = (bool)e.Value!)" />
            <PBCheckbox Label="SMS notifications" checked="@smsEnabled" @onchange="@((ChangeEventArgs e) => smsEnabled = (bool)e.Value!)" />
            <span class="status">Email: @emailEnabled, SMS: @smsEnabled</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled checkbox cannot be changed.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBCheckbox Label=""Locked setting"" disabled />")">
            <PBCheckbox Label="Locked setting" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered next to the checkbox.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="checkbox"&gt;</code>, including <code>checked</code>, <code>disabled</code> and <code>@@onchange</code>.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The label text and input are wrapped in a single <code>&lt;label&gt;</code>,
            so clicking the text toggles the checkbox and it is announced with its
            label automatically.
        </div>
    </section>
</div>

@code {
    private bool emailEnabled = true;
    private bool smsEnabled;
}
