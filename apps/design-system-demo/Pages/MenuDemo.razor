@page "/menu"
@rendermode InteractiveServer

<PageTitle>Menu · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <PageHeader Title="Menu">
        A menu exposes a list of contextual actions behind a trigger button. It
        opens on click and closes on selection, outside click, or Escape.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">A menu grouping a set of related actions.</p>

        <ExampleCard Title="Row actions" RazorCode="@(
@"<PBMenu Label=""Row actions"" @bind-IsOpen=""isOpen"">
    <Trigger>Actions</Trigger>
    <ChildContent>
        <button @onclick=""Edit"">Edit</button>
        <button @onclick=""Duplicate"">Duplicate</button>
        <button @onclick=""Delete"">Delete</button>
    </ChildContent>
</PBMenu>")">
            <PBMenu Label="Row actions" @bind-IsOpen="isOpen">
                <Trigger>Actions ▾</Trigger>
                <ChildContent>
                    <button type="button" class="pb-menu-item" @onclick='() => SelectAction("Edit")'>Edit</button>
                    <button type="button" class="pb-menu-item" @onclick='() => SelectAction("Duplicate")'>Duplicate</button>
                    <button type="button" class="pb-menu-item" @onclick='() => SelectAction("Delete")'>Delete</button>
                </ChildContent>
            </PBMenu>
            <span class="status">Last action: @(selectedAction ?? "—")</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Accessible name for the trigger button and the menu panel.</td></tr>
                <tr><td><code>Trigger</code></td><td><code>RenderFragment?</code></td><td>Content of the button that opens the menu.</td></tr>
                <tr><td><code>IsOpen</code></td><td><code>bool</code></td><td>Whether the panel is open. Supports <code>@@bind-IsOpen</code>.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The menu's actions.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The trigger has <code>aria-haspopup="menu"</code> and
            <code>aria-expanded</code>. The panel uses <code>role="menu"</code>.
            Escape closes the menu and returns focus to the trigger; clicking outside
            the panel (a full-viewport scrim) also closes it.
        </div>
    </section>
</div>

@code {
    private bool isOpen;
    private string? selectedAction;

    private void SelectAction(string action)
    {
        selectedAction = action;
        isOpen = false;
    }
}
