@page "/progress-spinner"
@rendermode InteractiveServer

<PageTitle>Progress Spinner · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <header class="doc-header">
        <span class="eyebrow">Component</span>
        <h1>Progress Spinner</h1>
        <p class="intro">
            A progress spinner communicates that an operation is in progress when the
            duration is unknown.
        </p>
    </header>

    <section class="doc-section">
        <h2>Loading</h2>
        <p class="field-hint">An indeterminate spinner with an accessible label.</p>

        <div class="doc-example">
            <PBProgressSpinner Label="Loading content" />
        </div>

        <CodeSnippet Code="@(@"<PBProgressSpinner Label=""Loading content"" />")" />
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Rendered as <code>aria-label</code> on the spinner.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders a native indeterminate <code>&lt;progress&gt;</code> element with
            an <code>aria-label</code>, so it is announced without further markup.
        </div>
    </section>
</div>
