@page "/progress-spinner"
@rendermode InteractiveServer

<PageTitle>Progress Spinner · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Progress Spinner</h2>
            </div>
            <div>
                <span>Show an indeterminate loading state.</span>
            </div>
        </div>

        <p class="intro">
            A progress spinner communicates that an operation is in progress when the
            duration is unknown.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Loading</legend>
                <p class="field-hint">An indeterminate spinner with an accessible label.</p>
                <ProgressSpinner Label="Loading content" />
            </fieldset>

        </div>
    </div>
</div>
