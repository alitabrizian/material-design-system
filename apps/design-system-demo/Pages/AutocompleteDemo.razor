@page "/autocomplete"
@rendermode InteractiveServer
@using Design.Components

<PageTitle>Autocomplete · Design System</PageTitle>

<div class="catalog-content">

        <div class="catalog-toolbar" aria-label="Component catalog tools">
            <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
        </div>

        <div class="showcase">
            <div class="playground-heading">
                <div>
                    <span class="eyebrow">Component</span>
                    <h2>Autocomplete</h2>
                </div>
                <div>
                    <span>Suggest relevant options as you type.</span>
                </div>
            </div>

            <p class="intro">
                The autocomplete is a text input enhanced by a panel of suggested options.
                Type to filter the list, use arrow keys to navigate, Enter to select, and
                Escape to dismiss the panel.
            </p>

            <div class="control-grid">

                <!-- Simple autocomplete -->
                <fieldset class="playground-field">
                    <legend>Simple autocomplete</legend>
                    <p class="field-hint">A basic list of string options filtered as you type.</p>
                    <Autocomplete
                        Label="Pick a fruit"
                        Placeholder="Start typing..."
                        @bind-SelectedOption="selectedFruit"
                        Options="fruitOptions" />
                    <span class="status">@selectedFruit</span>
                </fieldset>

                <!-- Custom filter -->
                <fieldset class="playground-field">
                    <legend>Custom filter</legend>
                    <p class="field-hint">Filter options that <em>contain</em> the search text anywhere (not just at the start).</p>
                    <Autocomplete
                        Label="Find a country"
                        Placeholder="Type a country name..."
                        @bind-SelectedOption="selectedCountry"
                        Options="countryOptions"
                        Filter="ContainsFilter" />
                    <span class="status">@selectedCountry</span>
                </fieldset>

                <!-- Complex objects -->
                <fieldset class="playground-field">
                    <legend>Complex objects</legend>
                    <p class="field-hint">Display one property and use another as the selected value.</p>
                    <Autocomplete
                        Label="Choose a city"
                        Placeholder="Type a city name..."
                        @bind-SelectedOption="selectedCity"
                        Options="cityOptions"
                        DisplayProperty="Name"
                        ValueProperty="Code" />
                    <span class="status">Selected: @selectedCity?.Name ?? "—" (code: @selectedCity?.Code ?? "—")</span>
                </fieldset>

                <!-- Disabled state -->
                <fieldset class="playground-field">
                    <legend>Disabled state</legend>
                    <p class="field-hint">The component is non-interactive when disabled.</p>
                    <Autocomplete
                        Label="Disabled input"
                        Placeholder="Cannot type here"
                        Options="fruitOptions"
                        Enabled="false" />
                    <span class="status">Disabled</span>
                </fieldset>

            </div>
        </div>
    </div>

