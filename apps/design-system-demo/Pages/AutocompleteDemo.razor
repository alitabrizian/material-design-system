@page "/autocomplete"
@rendermode InteractiveServer

<PageTitle>Autocomplete · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Autocomplete">
        The autocomplete is a text input enhanced by a panel of suggested options.
        Type to filter the list, use the arrow keys to navigate, Enter to select,
        and Escape to dismiss the panel.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">
            Bind <code>SelectedOption</code> to a plain list of options. By default the
            list is filtered to entries that start with the typed text.
        </p>

        <ExampleCard Title="Simple autocomplete" RazorCode="@(
@"<PBAutoComplete
    Label=""Pick a fruit""
    Placeholder=""Start typing...""
    @bind-SelectedOption=""selectedFruit""
    Options=""fruitOptions"" />")">
            <PBAutoComplete
                Label="Pick a fruit"
                Placeholder="Start typing..."
                @bind-SelectedOption="selectedFruit"
                Options="fruitOptions" />
            <span class="status">Selected: @(selectedFruit ?? "—")</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">
            Pass a <code>Filter</code> callback to control how the option list narrows
            as the user types. This example matches the search text anywhere in the
            option, not just at the start.
        </p>

        <ExampleCard Title="Adding a custom filter"
            RazorCode="@(
@"<PBAutoComplete
    Label=""Find a country""
    Placeholder=""Type a country name...""
    @bind-SelectedOption=""selectedCountry""
    Options=""countryOptions""
    Filter=""ContainsFilter"" />")"
            CSharpCode="@(
@"private static IEnumerable<string?> ContainsFilter(string input, IEnumerable<string?> options) =>
    string.IsNullOrWhiteSpace(input)
        ? options
        : options.Where(o => o.Contains(input, StringComparison.OrdinalIgnoreCase));")">
            <PBAutoComplete
                Label="Find a country"
                Placeholder="Type a country name..."
                @bind-SelectedOption="selectedCountry"
                Options="countryOptions"
                Filter="ContainsFilter" />
            <span class="status">Selected: @(selectedCountry ?? "—")</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">
            When the options are objects rather than strings, use
            <code>DisplayProperty</code> to choose what is shown in the panel and
            <code>ValueProperty</code> to choose the underlying value.
        </p>

        <ExampleCard Title="Setting separate control and display values" RazorCode="@(
@"<PBAutoComplete
    Label=""Choose a city""
    Placeholder=""Type a city name...""
    @bind-SelectedOption=""selectedCity""
    Options=""cityOptions""
    DisplayProperty=""Name""
    ValueProperty=""Code"" />")">
            <PBAutoComplete
                Label="Choose a city"
                Placeholder="Type a city name..."
                @bind-SelectedOption="selectedCity"
                Options="cityOptions"
                DisplayProperty="Name"
                ValueProperty="Code" />
            <span class="status">Selected: @(selectedCity?.Name ?? "—") (code: @(selectedCity?.Code ?? "—"))</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">
            <code>PBAutoComplete</code> does not currently enforce that the typed text
            resolves to one of the supplied options — it is a free-text input with
            suggestions. Until that validation is built into the component, gate the
            dependent action on <code>SelectedOption</code> being set, as shown below.
        </p>

        <ExampleCard Title="Require an autocomplete option to be selected" RazorCode="@(
@"<PBAutoComplete
    Label=""Pick a fruit to continue""
    @bind-SelectedOption=""selectedFruit""
    Options=""fruitOptions"" />

<PBButton disabled=""@(selectedFruit is null)"">Continue</PBButton>")">
            <PBAutoComplete
                Label="Pick a fruit to continue"
                Placeholder="Start typing..."
                @bind-SelectedOption="selectedRequiredFruit"
                Options="fruitOptions" />
            <div class="actions">
                <PBButton disabled="@(selectedRequiredFruit is null)">Continue</PBButton>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">
            The first option in the filtered list is highlighted automatically as you
            type, so pressing Enter immediately selects the best match without an
            extra arrow-key press.
        </p>

        <ExampleCard Title="Automatically highlighting the first option" RazorCode="@(
@"<PBAutoComplete
    Label=""Type a country name""
    @bind-SelectedOption=""selectedCountry""
    Options=""countryOptions"" />")">
            <PBAutoComplete
                Label="Type a country name"
                Placeholder="Try 'united'..."
                @bind-SelectedOption="selectedHighlightCountry"
                Options="countryOptions" />
            <span class="status">Selected: @(selectedHighlightCountry ?? "—")</span>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Set <code>Enabled="false"</code> to make the input non-interactive.</p>

        <ExampleCard Title="Disabled state" RazorCode="@(@"<PBAutoComplete Label=""Disabled input"" Options=""fruitOptions"" Enabled=""false"" />")">
            <PBAutoComplete Label="Disabled input" Placeholder="Cannot type here" Options="fruitOptions" Enabled="false" />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Accessible label shown above the input.</td></tr>
                <tr><td><code>Options</code></td><td><code>IEnumerable&lt;TItem&gt;?</code></td><td>The full set of selectable options.</td></tr>
                <tr><td><code>SelectedOption</code></td><td><code>TItem?</code></td><td>The currently selected option. Supports <code>@@bind-SelectedOption</code>.</td></tr>
                <tr><td><code>Placeholder</code></td><td><code>string?</code></td><td>Placeholder text shown in the empty input.</td></tr>
                <tr><td><code>Enabled</code></td><td><code>bool</code></td><td>Whether the input accepts interaction. Defaults to <code>true</code>.</td></tr>
                <tr><td><code>DisplayProperty</code></td><td><code>string?</code></td><td>Property name used to render each option's text.</td></tr>
                <tr><td><code>ValueProperty</code></td><td><code>string?</code></td><td>Property name used as the option's underlying value.</td></tr>
                <tr><td><code>Filter</code></td><td><code>Func&lt;string, IEnumerable&lt;TItem&gt;, IEnumerable&lt;TItem&gt;&gt;?</code></td><td>Custom filter run against the typed text.</td></tr>
            </tbody>
        </table>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The input exposes <code>aria-expanded</code>, <code>aria-haspopup="listbox"</code>,
            <code>aria-controls</code>, and <code>aria-activedescendant</code>. The panel
            uses <code>role="listbox"</code> and each option uses
            <code>role="option"</code> with <code>aria-selected</code>. Arrow keys move
            the highlighted option, Enter selects it, and Escape closes the panel.
        </div>
    </section>
</div>

