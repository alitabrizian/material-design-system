    private static IEnumerable<string?> ContainsFilter(string input, IEnumerable<string?> options)
    {
        if (string.IsNullOrWhiteSpace(input))
            return options;

        var lower = input.ToLowerInvariant();
        return options.Where(o => o.ToLowerInvariant().Contains(lower));
    }

    public class City
    {
        public string Name { get; }
        public string Code { get; }
        public City(string name, string code) { Name = name; Code = code; }
        public override string ToString() => Name;
    }
