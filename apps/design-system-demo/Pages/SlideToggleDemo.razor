@page "/slide-toggle"
@rendermode InteractiveServer

<PageTitle>Slide Toggle · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Slide Toggle">A slide toggle switches a single setting between an on and an off state.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Flipping the switch updates the status below.</p>

        <ExampleCard Title="Dark mode" RazorCode="@(
@"<PBSlideToggle Label=""Enable dark mode""
    checked=""@darkModeEnabled""
    @onchange=""@((ChangeEventArgs e) => darkModeEnabled = (bool)e.Value!)"" />")">
            <PBSlideToggle Label="Enable dark mode" checked="@darkModeEnabled" @onchange="@((ChangeEventArgs e) => darkModeEnabled = (bool)e.Value!)" />
            <p class="status">Dark mode: @(darkModeEnabled ? "on" : "off")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled toggle cannot be changed.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBSlideToggle Label=""Locked setting"" disabled />")">
            <PBSlideToggle Label="Locked setting" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">Without the check/minus icons in the handle (<code>HideIcon</code>).</p>

        <ExampleCard Title="Hidden icon" RazorCode="@(@"<PBSlideToggle Label=""Wi-Fi"" HideIcon checked />")">
            <PBSlideToggle Label="Wi-Fi" HideIcon checked="@wifi" @onchange="@(e => wifi = (bool)e.Value!)" />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered next to the switch.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="checkbox" role="switch"&gt;</code>.</td></tr>
                <tr><td><code>HideIcon</code></td><td><code>bool</code></td><td>Hides the icons in the handle.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Uses <code>role="switch"</code> on the checkbox input, so assistive
            technology announces it as an on/off switch rather than a checkbox.
        </div>
    </section>
</div>

@code {
    private bool wifi = true;

    private bool darkModeEnabled;
}
