@page "/timepicker"
@rendermode InteractiveServer

<PageTitle>Timepicker · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Timepicker">
        The timepicker lets users enter or pick a time of day using the
        browser's native time input.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Picking a time updates the status below.</p>

        <ExampleCard Title="Default" RazorCode="@(
@"<PBTimepicker Label=""Meeting time""
    value=""@selectedTime""
    @onchange=""@((ChangeEventArgs e) => selectedTime = e.Value?.ToString())"" />")">
            <PBTimepicker Label="Meeting time" value="@selectedTime" @onchange="@((ChangeEventArgs e) => selectedTime = e.Value?.ToString())" />
            <p class="status">Selected: @(selectedTime ?? "—")</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled timepicker cannot be changed.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBTimepicker Label=""Locked time"" disabled />")">
            <PBTimepicker Label="Locked time" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Floating label; always floated because the time input shows its format. The trailing clock button opens the browser's time picker.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="time"&gt;</code>.</td></tr>
                <tr><td><code>SupportingText</code> / <code>ErrorText</code></td><td><code>string?</code></td><td>Hint / error text under the field.</td></tr>
                <tr><td><code>Appearance</code></td><td><code>PBFormFieldAppearance</code></td><td><code>Fill</code> (default) or <code>Outline</code>, like mat-form-field.</td></tr>
                <tr><td><code>Prefix</code> / <code>Suffix</code></td><td><code>RenderFragment?</code></td><td>Leading / trailing icons (matIconPrefix / matIconSuffix).</td></tr>
                <tr><td><code>Block</code></td><td><code>bool</code></td><td>Stretches the field to its container's width.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Uses the browser's native time input, so keyboard entry and locale
            formatting come from the platform.
        </div>
    </section>
</div>

@code {
    private string? selectedTime;
}
