@page "/timepicker"
@rendermode InteractiveServer

<PageTitle>Timepicker · Design System</PageTitle>

<div class="catalog-content">

    <div class="catalog-toolbar" aria-label="Component catalog tools">
        <a class="nav-link" href="/" aria-label="Back to catalog">← All components</a>
    </div>

    <div class="showcase">
        <div class="playground-heading">
            <div>
                <span class="eyebrow">Component</span>
                <h2>Timepicker</h2>
            </div>
            <div>
                <span>Choose a time from a clock interface.</span>
            </div>
        </div>

        <p class="intro">
            The timepicker lets users enter or pick a time of day using the
            browser's native time input.
        </p>

        <div class="control-grid">

            <fieldset class="playground-field">
                <legend>Default</legend>
                <p class="field-hint">Picking a time updates the status below.</p>
                <Timepicker Label="Meeting time" value="@selectedTime" @onchange="@((ChangeEventArgs e) => selectedTime = e.Value?.ToString())" />
                <span class="status">Selected: @(selectedTime ?? "—")</span>
            </fieldset>

            <fieldset class="playground-field">
                <legend>Disabled</legend>
                <p class="field-hint">A disabled timepicker cannot be changed.</p>
                <Timepicker Label="Locked time" disabled />
            </fieldset>

        </div>
    </div>
</div>

@code {
    private string? selectedTime;
}
