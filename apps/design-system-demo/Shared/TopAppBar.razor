@inject ThemeState Theme
@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="pb-topbar">
    <span class="pb-topbar__title">@Title</span>

    <div class="pb-topbar__actions">
        <PBMenu Label="Theme" @bind-IsOpen="themeMenuOpen">
            <Trigger>
                <span class="material-icons" aria-hidden="true">palette</span>
            </Trigger>
            <ChildContent>
                @foreach (var theme in ThemeState.Themes)
                {
                    var selected = Theme.Theme == theme.Key;
                    <button type="button" role="menuitemradio" aria-checked="@(selected ? "true" : "false")"
                        class="pb-menu-item @(selected ? "pb-menu-item--selected" : "")" @onclick="() => SelectThemeAsync(theme.Key)">
                        <span class="pb-menu-item__radio" aria-hidden="true"></span>
                        <span class="pb-menu-item__label">@theme.Name</span>
                        <span class="pb-menu-item__swatch--theme" aria-hidden="true">
                            <span style="background:@theme.PrimarySeed;"></span>
                            <span style="background:@theme.TertiarySeed;"></span>
                        </span>
                    </button>
                }
            </ChildContent>
        </PBMenu>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    private bool themeMenuOpen;
    private IJSObjectReference? module;

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // JS interop is unavailable during static prerendering, so the very first
        // paint uses ThemeState's default (Rose & Red) for the checkmark. The
        // <html data-theme> attribute is already correct from App.razor's inline
        // FOUC script, so page colors never flash; only this brief correction of
        // the menu's selected-radio state happens post-render.
        module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/theme.js");

        var stored = await module.InvokeAsync<string?>("getStoredTheme");
        Theme.Initialize(stored);
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private Task SelectThemeAsync(string key)
    {
        Theme.SetTheme(key);
        themeMenuOpen = false;
        return PersistAndApplyAsync();
    }

    private async Task PersistAndApplyAsync()
    {
        if (module is null)
            return;

        await module.InvokeVoidAsync("applyTheme", Theme.Theme);
        await module.InvokeVoidAsync("setStoredTheme", Theme.Theme);
    }

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;

        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }
}
