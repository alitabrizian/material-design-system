@inject ThemeState Theme
@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="pb-topbar">
    <PBButton Variant="PBButtonVariant.Icon" class="pb-topbar__menu" aria-label="Open navigation" @onclick="OnMenuClick">
        <span class="material-icons" aria-hidden="true">menu</span>
    </PBButton>
    <span class="pb-topbar__title">@Title</span>

    <div class="pb-topbar__actions">
        <PBTooltip Label="Select a theme">
            <PBMenu Label="Theme" XPosition="PBMenuXPosition.Before" PanelClass="theme-picker" @bind-IsOpen="themeMenuOpen">
                <Trigger>
                    <span class="material-icons" aria-hidden="true">palette</span>
                </Trigger>
                <ChildContent>
                    <div class="theme-picker__heading" role="presentation">Theme</div>
                    @foreach (var theme in ThemeState.Themes)
                    {
                        var key = theme.Key;
                        <PBMenuItem Role="menuitemradio" Checked="Theme.Theme == key" OnClick="() => SelectThemeAsync(key)">
                            <ChildContent>@theme.Name</ChildContent>
                            <Trailing>
                                @* The swatch carries data-theme, so it renders from that theme's own tokens. *@
                                <span class="theme-swatch" data-theme="@key" aria-hidden="true">
                                    <span class="theme-swatch__primary"></span>
                                    <span class="theme-swatch__secondary"></span>
                                    <span class="theme-swatch__tertiary"></span>
                                </span>
                            </Trailing>
                        </PBMenuItem>
                    }
                </ChildContent>
            </PBMenu>
        </PBTooltip>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Raised by the navigation button shown on narrow screens.</summary>
    [Parameter] public EventCallback MenuClicked { get; set; }

    private bool themeMenuOpen;
    private IJSObjectReference? module;

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The <html data-theme> attribute was set before first paint by App.razor's inline script;
        // read it back so the picker marks the right theme.
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");
        Theme.Initialize(await module.InvokeAsync<string?>("getTheme"));
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private Task OnMenuClick() => MenuClicked.InvokeAsync();

    private async Task SelectThemeAsync(string key)
    {
        Theme.SetTheme(key);
        if (module is not null)
        {
            await module.InvokeVoidAsync("selectTheme", key);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
