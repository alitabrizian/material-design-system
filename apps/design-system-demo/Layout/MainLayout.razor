@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavManager

<div class="catalog-shell">
    <aside class="catalog-sidebar" aria-label="Design system navigation">
        <a class="brand-lockup" href="/" aria-label="Workspace Design System home">
            <span class="brand-mark">W</span>
            <span>
                <strong>Workspace</strong>
                <small>Design system</small>
            </span>
        </a>

        <nav class="side-nav" aria-label="Components">
            <div class="component-menu">
                @foreach (var item in ComponentCatalog.Items)
                {
                    <a class="nav-link @(IsActive(item.Route) ? "active" : null)" href="@item.Route">@item.Name</a>
                }
            </div>
        </nav>

        <div class="sidebar-footer">
            <span class="status-dot" aria-hidden="true"></span>
            <span>v1.0.0</span>
        </div>
    </aside>

    <main class="page-shell">
        <TopAppBar Title="@CurrentTitle" />
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private bool IsActive(string route)
    {
        var currentPath = "/" + NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
        return string.Equals(currentPath, route, StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentTitle =>
        ComponentCatalog.Items.FirstOrDefault(item => IsActive(item.Route))?.Name ?? "Design System";

    public void Dispose() => NavManager.LocationChanged -= OnLocationChanged;
}
