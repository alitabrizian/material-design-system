@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavManager

<div class="catalog-shell">
    <div class="catalog-nav-column">
        <aside class="catalog-sidebar" aria-label="Design system navigation">
            @Navigation
        </aside>
    </div>

    <PBSidenav Mode="PBSidenavMode.Over" class="catalog-drawer" Label="Design system navigation" @bind-Opened="drawerOpen">
        <div class="catalog-sidebar">@Navigation</div>
    </PBSidenav>

    <main class="page-shell">
        <TopAppBar Title="@CurrentTitle" MenuClicked="() => drawerOpen = true" />
        @Body
    </main>
</div>

@code {
    private bool drawerOpen;

    private RenderFragment Navigation => @<text>
        <a class="brand-lockup" href="/" aria-label="Workspace Design System home">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span>
                <strong>Workspace</strong>
                <small>Angular Material M3 for Blazor</small>
            </span>
        </a>

        <nav class="side-nav" aria-label="Components">
            <div class="nav-heading">Components</div>
            @foreach (var item in ComponentCatalog.Items)
            {
                var active = IsActive(item.Route);
                <a class="nav-link @(active ? "active" : null)" href="@item.Route" aria-current="@(active ? "page" : null)">@item.Name</a>
            }
        </nav>

        <div class="sidebar-footer">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Angular Material 22.2 · M3</span>
        </div>
    </text>;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string route)
    {
        var currentPath = "/" + NavManager.ToBaseRelativePath(NavManager.Uri).Split('#', '?')[0].TrimEnd('/');
        return string.Equals(currentPath, route, StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentTitle =>
        ComponentCatalog.Items.FirstOrDefault(item => IsActive(item.Route))?.Name ?? "Design System";

    public void Dispose() => NavManager.LocationChanged -= OnLocationChanged;
}
