{
  "name": "remotion-videos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/remotion-videos/src",
  "projectType": "application",
  "targets": {
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "remotion studio src/index.ts",
        "cwd": "apps/remotion-videos"
      }
    },
    "render": {
      "executor": "nx:run-commands",
      "options": {
        "command": "remotion render src/index.ts AutocompleteDemo out/autocomplete-demo.mp4",
        "cwd": "apps/remotion-videos"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "remotion bundle src/index.ts",
        "cwd": "apps/remotion-videos"
      }
    }
  },
  "tags": ["type:app", "scope:media"]
}
