@page "/bottom-sheet"
@rendermode InteractiveServer

<PageTitle>Bottom Sheet · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Bottom Sheet">
        PBBottomSheet slides a panel of content up from the bottom of the screen, typically
        holding a list of actions.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Render the sheet while it should be open; it raises <code>Dismissed</code> on Escape or a scrim click.</p>

        <ExampleCard Title="Bottom sheet overview" RazorCode="@(
@"<PBButton Variant=""PBButtonVariant.Outlined"" @onclick=""() => open = true"">Open file</PBButton>

@if (open)
{
    <PBBottomSheet Label=""Open with"" Dismissed=""() => open = false"">
        <PBList Role=""presentation"">
            <PBListItem Title=""Google Keep"" Subtitle=""Add to a note"" OnClick=""() => Pick(""Keep"")"" />
            <PBListItem Title=""Google Docs"" Subtitle=""Embed in a document"" OnClick=""() => Pick(""Docs"")"" />
        </PBList>
    </PBBottomSheet>
}")">
            <PBButton Variant="PBButtonVariant.Outlined" @onclick="() => open = true">Open file</PBButton>
            <p class="status">Picked: @(picked ?? "—")</p>
            @if (open)
            {
                <PBBottomSheet Label="Open with" Dismissed="() => open = false">
                    <PBList Role="presentation">
                        <PBListItem Title="Google Keep" Subtitle="Add to a note" OnClick='() => Pick("Google Keep")' />
                        <PBListItem Title="Google Docs" Subtitle="Embed in a document" OnClick='() => Pick("Google Docs")' />
                        <PBListItem Title="Google Plus" Subtitle="Share with your friends" OnClick='() => Pick("Google Plus")' />
                        <PBListItem Title="Google Hangouts" Subtitle="Show to your coworkers" OnClick='() => Pick("Google Hangouts")' />
                    </PBList>
                </PBBottomSheet>
            }
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Accessible name of the sheet.</td></tr>
                <tr><td><code>Dismissed</code></td><td><code>EventCallback</code></td><td>Raised on Escape or a scrim click.</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>The sheet content.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The sheet is a labelled modal <code>dialog</code> that takes focus when it opens; Escape
            closes it. Return focus to the element that opened it when it closes.
        </div>
    </section>
</div>

@code {
    private bool open;
    private string? picked;

    private void Pick(string app)
    {
        picked = app;
        open = false;
    }
}
