{
  "name": "design-system-landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/design-system-landing/src",
  "implicitDependencies": ["design-tokens"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/dev-design-system-landing.mts --build",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/apps/design-system-landing"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/dev-design-system-landing.mts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["type:app", "scope:design-system"]
}
