@using System.Text.RegularExpressions
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="example-card" id="@ResolvedId">
    <div class="example-card-header">
        <span class="example-card-title">@Title</span>
        <span class="example-card-actions">
            <button type="button" class="icon-btn" title="Copy link" aria-label="Copy link to this example" @onclick="CopyLink">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 14a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.5 1.5" /><path d="M14 10a5 5 0 0 0-7.07 0L4.1 12.83a5 5 0 0 0 7.07 7.07l1.5-1.5" /></svg>
            </button>
            <button type="button" class="icon-btn @(showCode ? "is-active" : null)" title="@(showCode ? "Hide code" : "Show code")" aria-label="Toggle code" @onclick="ToggleCode">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="8 6 2 12 8 18" /><polyline points="16 6 22 12 16 18" /></svg>
            </button>
            <button type="button" class="icon-btn" title="Open in new tab" aria-label="Open this example in a new tab" @onclick="OpenInNew">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
            </button>
        </span>
    </div>

    @if (showCode)
    {
        <div class="example-tabs" role="tablist">
            @foreach (var tab in Tabs)
            {
                <button type="button" class="example-tab @(activeTab == tab.Key ? "active" : null)" role="tab" aria-selected="@(activeTab == tab.Key ? "true" : "false")" @onclick="() => SelectTab(tab.Key)">@tab.Label</button>
            }
        </div>

        <div class="example-code-panel">
            <button type="button" class="example-code-copy icon-btn" title="Copy code" aria-label="Copy code" @onclick="CopyCode">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
            </button>
            <pre><code>@ActiveHighlighted</code></pre>
        </div>
    }

    <div class="example-live @(showCode ? "with-code" : null)">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string RazorCode { get; set; } = string.Empty;
    [Parameter] public string? CSharpCode { get; set; }
    [Parameter] public string? CssCode { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private bool showCode;
    private string activeTab = "razor";

    private string ResolvedId => Id ?? Slugify(Title);

    private List<(string Key, string Label)> Tabs
    {
        get
        {
            var tabs = new List<(string Key, string Label)> { ("razor", ".razor") };
            if (!string.IsNullOrWhiteSpace(CSharpCode)) tabs.Add(("cs", ".cs"));
            if (!string.IsNullOrWhiteSpace(CssCode)) tabs.Add(("css", ".css"));
            return tabs;
        }
    }

    private string ActiveCode => activeTab switch
    {
        "cs" => CSharpCode ?? string.Empty,
        "css" => CssCode ?? string.Empty,
        _ => RazorCode,
    };

    private MarkupString ActiveHighlighted => CodeHighlighter.Highlight(ActiveCode, activeTab switch
    {
        "cs" => "csharp",
        "css" => "css",
        _ => "razor",
    });

    protected override void OnParametersSet()
    {
        if (!Tabs.Any(t => t.Key == activeTab))
            activeTab = "razor";
    }

    private void ToggleCode() => showCode = !showCode;

    private void SelectTab(string tab) => activeTab = tab;

    private string ExampleUrl => Nav.Uri.Split('#')[0] + "#" + ResolvedId;

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExampleUrl);
    }

    private async Task CopyCode()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ActiveCode);
    }

    private async Task OpenInNew()
    {
        await JS.InvokeVoidAsync("open", ExampleUrl, "_blank");
    }

    private static string Slugify(string value)
    {
        var lowered = value.ToLowerInvariant();
        var slug = Regex.Replace(lowered, @"[^a-z0-9]+", "-").Trim('-');
        return string.IsNullOrEmpty(slug) ? "example" : slug;
    }
}
