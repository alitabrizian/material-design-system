@page "/"
@rendermode InteractiveServer

<PageTitle>Components · Design System</PageTitle>

@* Mirrors Angular Material's components/categories page: an intro line and a centered grid of
   fixed-width cards, each a scene image, a title and a one-line summary. *@
<div class="docs-category-list-page">
    <div class="docs-category-list-summary">
        Workspace offers a wide variety of UI components based on the
        <a href="https://material.io/components">Material Design specification</a>
    </div>

    <div class="docs-category-list">
        @foreach (var component in ComponentCatalog.Items)
        {
            <a class="docs-category-list-item" href="@component.Route">
                <div class="docs-category-list-card pb-ripple-host">
                    <img class="docs-category-list-card-image" src="assets/screenshots/@(component.Scene).scene.png"
                         alt="" aria-hidden="true" loading="lazy" />
                    <div class="docs-category-list-card-title">@component.Name</div>
                    <div class="docs-category-list-card-summary">@component.Summary</div>
                </div>
            </a>
        }
    </div>
</div>
