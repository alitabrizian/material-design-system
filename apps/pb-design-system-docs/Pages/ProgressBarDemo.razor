@page "/progress-bar"
@rendermode InteractiveServer

<PageTitle>Progress Bar · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Progress Bar">A progress bar communicates the completion of a determinate operation.</PageHeader>

    <section class="doc-section">
        <p class="field-hint">Use the buttons to advance the progress value.</p>

        <ExampleCard Title="Determinate" RazorCode="@(@"<PBProgressBar Value=""@progress"" />")">
            <PBProgressBar Value="@progress" />
            <p class="status">@progress%</p>
            <div class="actions">
                <PBButton @onclick="() => progress = Math.Max(0, progress - 10)">-10%</PBButton>
                <PBButton @onclick="() => progress = Math.Min(100, progress + 10)">+10%</PBButton>
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint"><code>Indeterminate</code> shows a continuously animated track for an operation of unknown duration.</p>

        <ExampleCard Title="Indeterminate" RazorCode="@(@"<PBProgressBar Indeterminate=""true"" />")">
            <PBProgressBar Indeterminate="true" />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint"><code>BufferValue</code> shows a lighter, secondary track segment (e.g. how much of a video has buffered) behind the main value.</p>

        <ExampleCard Title="Buffered" RazorCode="@(@"<PBProgressBar Value=""45"" BufferValue=""70"" />")">
            <PBProgressBar Value="45" BufferValue="70" />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Value</code></td><td><code>double</code></td><td>0-100. Ignored when <code>Indeterminate</code> is set.</td></tr>
                <tr><td><code>Indeterminate</code></td><td><code>bool</code></td><td>Shows a continuously animated track instead of a fixed value.</td></tr>
                <tr><td><code>BufferValue</code></td><td><code>double?</code></td><td>0-100. Renders a lighter track segment behind <code>Value</code>.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;div role="progressbar"&gt;</code>.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Renders <code>role="progressbar"</code> with <code>aria-valuemin</code>/<code>aria-valuemax</code>/<code>aria-valuenow</code> (the latter omitted while indeterminate), which assistive technology reads the same way a native <code>&lt;progress&gt;</code> element would.
        </div>
    </section>
</div>

@code {
    private int progress = 40;
}
