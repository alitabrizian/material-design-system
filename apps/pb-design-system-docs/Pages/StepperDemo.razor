@page "/stepper"
@rendermode InteractiveServer

<PageTitle>Stepper · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Stepper">
        PBStepper provides a wizard-like workflow by dividing content into logical steps,
        horizontal or vertical, linear or free.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">A horizontal stepper. Completed steps show an edit icon; use <code>NextAsync</code>/<code>PreviousAsync</code> from buttons inside the steps.</p>

        <ExampleCard Title="Stepper overview" RazorCode="@(
@"<PBStepper @ref=""stepper"" @bind-SelectedIndex=""step"" Label=""Checkout"">
    <PBStep Label=""Fill out your name"">
        <PBInput Label=""Name"" />
        <PBButton @onclick=""() => stepper.NextAsync()"">Next</PBButton>
    </PBStep>
    <PBStep Label=""Fill out your address"">...</PBStep>
    <PBStep Label=""Done"">...</PBStep>
</PBStepper>")">
            <PBStepper @ref="stepper" @bind-SelectedIndex="step" Label="Checkout">
                <PBStep Label="Fill out your name">
                    <PBInput Label="Name" placeholder="Last name, First name" />
                    <div class="actions"><PBButton @onclick="() => stepper!.NextAsync()">Next</PBButton></div>
                </PBStep>
                <PBStep Label="Fill out your address">
                    <PBInput Label="Address" placeholder="Ex. 1 Main St, New York, NY" />
                    <div class="actions">
                        <PBButton @onclick="() => stepper!.PreviousAsync()">Back</PBButton>
                        <PBButton @onclick="() => stepper!.NextAsync()">Next</PBButton>
                    </div>
                </PBStep>
                <PBStep Label="Done">
                    <p>You are now done.</p>
                    <div class="actions">
                        <PBButton @onclick="() => stepper!.PreviousAsync()">Back</PBButton>
                        <PBButton @onclick="() => stepper!.ResetAsync()">Reset</PBButton>
                    </div>
                </PBStep>
            </PBStepper>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A vertical stepper with an optional step and a step in error.</p>

        <ExampleCard Title="Vertical stepper" RazorCode="@(
@"<PBStepper Orientation=""PBStepperOrientation.Vertical"">
    <PBStep Label=""Cart"">...</PBStep>
    <PBStep Label=""Shipping"" Optional>...</PBStep>
    <PBStep Label=""Payment"" HasError ErrorMessage=""Card declined"">...</PBStep>
</PBStepper>")">
            <PBStepper Orientation="PBStepperOrientation.Vertical" Label="Order" @bind-SelectedIndex="verticalStep">
                <PBStep Label="Cart">
                    <p>Three items in your cart.</p>
                    <PBButton @onclick="() => verticalStep = 1">Next</PBButton>
                </PBStep>
                <PBStep Label="Shipping" Optional>
                    <p>Choose a delivery speed.</p>
                    <PBButton @onclick="() => verticalStep = 2">Next</PBButton>
                </PBStep>
                <PBStep Label="Payment" HasError ErrorMessage="Card declined">
                    <p>Enter another card.</p>
                </PBStep>
            </PBStepper>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Orientation</code></td><td><code>PBStepperOrientation</code></td><td><code>Horizontal</code> (default) or <code>Vertical</code>.</td></tr>
                <tr><td><code>SelectedIndex</code></td><td><code>int</code></td><td>The active step. Supports <code>@@bind-SelectedIndex</code>.</td></tr>
                <tr><td><code>Linear</code></td><td><code>bool</code></td><td>Steps can only be reached once the previous ones are completed.</td></tr>
                <tr><td><code>NextAsync()</code>, <code>PreviousAsync()</code>, <code>ResetAsync()</code></td><td>methods</td><td>Move to the next or previous step, or back to the first.</td></tr>
                <tr><td><code>PBStep.Label</code>, <code>LabelContent</code></td><td></td><td>The step header label.</td></tr>
                <tr><td><code>PBStep.Completed</code>, <code>Optional</code>, <code>Editable</code></td><td><code>bool?</code>, <code>bool</code>, <code>bool</code></td><td>Completion override, "Optional" hint, pencil (editable) vs check icon.</td></tr>
                <tr><td><code>PBStep.HasError</code>, <code>ErrorMessage</code></td><td><code>bool</code>, <code>string?</code></td><td>Error state with a warning icon and message.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            Step headers are <code>tab</code>s in a <code>tablist</code> with
            <code>aria-selected</code>; step content is a <code>tabpanel</code>. Arrow keys, Home and
            End move focus between headers; Enter or Space selects.
        </div>
    </section>
</div>

@code {
    private PBStepper? stepper;
    private int step;
    private int verticalStep;
}
