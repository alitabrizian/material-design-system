<!DOCTYPE html>
<html lang="en" data-theme="rose-red">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="data:," />
    <script>
        // Apply the saved theme before any stylesheet paints, so a reload never flashes the default.
        (function () {
            var validThemes = ["rose-red", "azure-blue", "magenta-violet", "cyan-orange"];
            var theme = null;
            try { theme = localStorage.getItem("theme"); } catch (e) { /* storage blocked: keep default */ }
            if (validThemes.indexOf(theme) === -1) theme = "rose-red";
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    @* Everything is self-hosted by the design system: no Google Fonts / CDN requests. *@
    <link rel="stylesheet" href="_content/PartoBita.DesignSystem.Blazor/css/fonts.css" />
    <link rel="stylesheet" href="_content/PartoBita.DesignSystem.Blazor/css/tokens.css" />
    <link rel="stylesheet" href="_content/PartoBita.DesignSystem.Blazor/design-system.css" />
    <link rel="stylesheet" href="app.css" />
    <script type="module" src="_content/PartoBita.DesignSystem.Blazor/design-system.js"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
