{
  "name": "pb-design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["design-system-blazor"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["tokens:build"],
      "options": {
        "command": "dotnet build Design.Demo.csproj",
        "cwd": "apps/pb-design-system"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/dev-pb-design-system.mts",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["design-system-blazor:pack"],
      "options": {
        "command": "dotnet run --project Design.Demo.csproj -p:UseDesignSystemPackage=true",
        "cwd": "apps/pb-design-system"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/verify-demo.mts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["type:app", "scope:design-system"]
}
