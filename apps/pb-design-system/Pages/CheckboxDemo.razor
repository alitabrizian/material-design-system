@page "/checkbox"
@rendermode InteractiveServer

<PageTitle>Checkbox · Design System</PageTitle>

<div class="catalog-content">

    <PageHeader Title="Checkbox">
        Checkboxes let users select one or more items from a set of independent
        options.
    </PageHeader>

    <section class="doc-section">
        <p class="field-hint">Each checkbox toggles independently.</p>

        <ExampleCard Title="Preferences" RazorCode="@(
@"<PBCheckbox Label=""Email notifications""
    checked=""@emailEnabled""
    @onchange=""@((ChangeEventArgs e) => emailEnabled = (bool)e.Value!)"" />")">
            <PBCheckbox Label="Email notifications" checked="@emailEnabled" @onchange="@((ChangeEventArgs e) => emailEnabled = (bool)e.Value!)" />
            <PBCheckbox Label="SMS notifications" checked="@smsEnabled" @onchange="@((ChangeEventArgs e) => smsEnabled = (bool)e.Value!)" />
            <p class="status">Email: @emailEnabled, SMS: @smsEnabled</p>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A disabled checkbox cannot be changed.</p>

        <ExampleCard Title="Disabled" RazorCode="@(@"<PBCheckbox Label=""Locked setting"" disabled />")">
            <PBCheckbox Label="Locked setting" disabled />
        </ExampleCard>
    </section>

    <section class="doc-section">
        <p class="field-hint">A parent checkbox in the indeterminate state while only some children are checked.</p>

        <ExampleCard Title="Indeterminate" RazorCode="@(
@"<PBCheckbox Label=""Select all"" checked=""@AllChecked"" Indeterminate=""@SomeChecked""
            @onchange=""@(e => SetAll((bool)e.Value!))"" />")">
            <PBCheckbox Label="Select all" checked="@AllChecked" Indeterminate="@SomeChecked" @onchange="@(e => SetAll((bool)e.Value!))" />
            <div style="padding-left:32px;display:flex;flex-direction:column">
                @for (var i = 0; i < subtasks.Length; i++)
                {
                    var index = i;
                    <PBCheckbox Label="@subtasks[index].Name" checked="@subtasks[index].Done" @onchange="@(e => subtasks[index].Done = (bool)e.Value!)" />
                }
            </div>
        </ExampleCard>
    </section>

    <section class="doc-section">
        <h2>API reference</h2>
        <div class="doc-table-wrapper">
        <table class="doc-table">
            <thead>
                <tr><th>Property</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
                <tr><td><code>Label</code></td><td><code>string?</code></td><td>Text rendered next to the checkbox.</td></tr>
                <tr><td><code>AdditionalAttributes</code></td><td><code>IReadOnlyDictionary&lt;string, object&gt;?</code></td><td>Passed through to the underlying <code>&lt;input type="checkbox"&gt;</code>, including <code>checked</code>, <code>disabled</code> and <code>@@onchange</code>.</td></tr>
                <tr><td><code>Indeterminate</code></td><td><code>bool</code></td><td>Shows the mixed state (a dash) and reports <code>aria-checked="mixed"</code>.</td></tr>
            </tbody>
        </table>
        </div>
    </section>

    <section class="doc-section">
        <div class="a11y-note">
            <strong>Accessibility</strong>
            The label text and input are wrapped in a single <code>&lt;label&gt;</code>,
            so clicking the text toggles the checkbox and it is announced with its
            label automatically.
        </div>
    </section>
</div>

@code {
    private sealed class Subtask(string name, bool done) { public string Name { get; } = name; public bool Done { get; set; } = done; }
    private readonly Subtask[] subtasks = [new("Primary", true), new("Accent", false), new("Warn", false)];
    private bool AllChecked => subtasks.All(t => t.Done);
    private bool SomeChecked => subtasks.Any(t => t.Done) && !AllChecked;
    private void SetAll(bool value) { foreach (var t in subtasks) t.Done = value; }

    private bool emailEnabled = true;
    private bool smsEnabled;
}
