{
  "name": "pb-design-system-angular-showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pb-design-system-angular-showcase/src",
  "implicitDependencies": ["design-system-angular"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["design-tokens:build"],
      "options": {
        "command": "ng build",
        "cwd": "apps/pb-design-system-angular-showcase"
      },
      "outputs": ["{workspaceRoot}/dist/apps/pb-design-system-angular-showcase"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["design-tokens:build"],
      "options": {
        "command": "ng serve --port 4200",
        "cwd": "apps/pb-design-system-angular-showcase"
      }
    }
  },
  "tags": ["type:app", "scope:design-system"]
}
