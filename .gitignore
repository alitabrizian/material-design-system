# dotnet pack output for local dev consumption (see libs/material-design-system/blazor/project.json)
# (the folder itself is committed via .gitkeep: NuGet.config lists it as a source, and restore
# fails with NU1301 on a fresh clone if it does not exist)
local-nuget-feed/*
!local-nuget-feed/.gitkeep

# Per-checkout NuGet package cache (globalPackagesFolder in NuGet.config)
.nuget/


.nx/cache
.nx/workspace-data
.nx/migrate-runs
# .NET
**/bin/
**/obj/
/artifacts/

# Playwright verification output (tools/scripts/verify-demo.mts)
.verify/

# Angular CLI build cache
.angular/
